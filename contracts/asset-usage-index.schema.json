{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/asset-usage-index.schema.json",
  "title": "AssetUsageIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_id", "build_id", "registry_id", "entries", "generated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "index_id": {"type": "string", "pattern": "^usage-[a-f0-9]{16}$"},
    "build_id": {"type": "string", "pattern": "^visual-[a-f0-9]{16}$"},
    "registry_id": {"type": "string", "pattern": "^registry-[a-f0-9]{16}$"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "content_sha256", "usages"],
      "properties": {
        "asset_id": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "usages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["site_id", "page_path", "slot"],
            "properties": {
              "site_id": {"type": "string"},
              "page_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_\\.-]*\\.html$"},
              "slot": {"enum": ["hero", "catalog_card", "detail_hero"]}
            }
          }
        }
      }
    }
  }
}
