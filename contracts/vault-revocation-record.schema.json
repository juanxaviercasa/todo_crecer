{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-revocation-record.schema.json",
  "title": "vault-revocation-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revocation_id",
    "target_type",
    "target_ref",
    "reason",
    "status",
    "revoked_by",
    "revoked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "revocation_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "target_type": {
      "enum": [
        "grant",
        "key",
        "object"
      ]
    },
    "target_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "revoked"
    },
    "revoked_by": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
