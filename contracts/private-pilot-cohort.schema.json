{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/private-pilot-cohort.schema.json",
  "title": "private-pilot-cohort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "candidate_refs",
    "archetypes",
    "access",
    "indexing",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "archetypes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "access": {
      "const": "private"
    },
    "indexing": {
      "const": "noindex"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "owner_confirmation",
        "ready",
        "blocked",
        "closed"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
