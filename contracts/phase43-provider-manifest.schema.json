{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase43-provider-manifest.schema.json",
  "title": "phase43-provider-manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "provider_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "synthetic_rehearsal",
        "real"
      ]
    },
    "format": {
      "type": "string",
      "const": "todolima-provider-onboarding-v1"
    },
    "object_count": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_digest": {
      "type": "string",
      "minLength": 1
    },
    "raw_identifiers_present": {
      "type": "boolean",
      "const": false
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "quarantined"
      ]
    },
    "received_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "candidate_ref",
    "provider_fingerprint",
    "evidence_mode",
    "format",
    "object_count",
    "manifest_digest",
    "raw_identifiers_present",
    "status",
    "received_at"
  ]
}
