{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/desired-state-record.schema.json","title":"DesiredStateRecord","type":"object","additionalProperties":false,"required":["schema_version","desired_state_id","tenant_id","site_id","generation","recipe_version_ref","design_version_ref","engine_version","configuration_digest","source_cohort_ref","updated_by","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"desired_state_id":{"type":"string","pattern":"^desired-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"generation":{"type":"integer","minimum":1},"recipe_version_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"design_version_ref":{"type":"string","pattern":"^dsv-[a-f0-9]{24}$"},"engine_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"configuration_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_cohort_ref":{"type":"string","pattern":"^cohort-[a-f0-9]{24}$"},"updated_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"updated_at":{"type":"string","format":"date-time"}}}
