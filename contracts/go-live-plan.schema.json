{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/go-live-plan.schema.json","title":"GoLivePlan","type":"object","additionalProperties":false,
  "required":["schema_version","plan_id","tenant_id","business_id","site_id","pilot_package_ref","package_digest","revision","synthetic","status","hostname","window","canary_stages","slo_targets","slo_policy_refs","incident_owner","rollback_target_ref","plan_digest","created_by","created_at","updated_at"],
  "properties":{
    "schema_version":{"const":"0.1.0"},"plan_id":{"type":"string","pattern":"^golivep-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"business_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "pilot_package_ref":{"type":"string","pattern":"^pilotp-[a-f0-9]{24}$"},"package_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"revision":{"type":"integer","minimum":1},"synthetic":{"type":"boolean"},"status":{"enum":["draft","frozen","approved","blocked","running","hypercare","closed","rolled_back"]},
    "hostname":{"type":"string","pattern":"^(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"},
    "window":{"type":"object","additionalProperties":false,"required":["start_at","end_at","timezone"],"properties":{"start_at":{"type":"string","format":"date-time"},"end_at":{"type":"string","format":"date-time"},"timezone":{"const":"America/Lima"}}},
    "canary_stages":{"type":"array","prefixItems":[{"const":5},{"const":25},{"const":50},{"const":100}],"items":false,"minItems":4,"maxItems":4},
    "slo_targets":{"type":"object","additionalProperties":false,"required":["availability_min_percent","latency_p95_max_ms"],"properties":{"availability_min_percent":{"type":"number","minimum":90,"maximum":100},"latency_p95_max_ms":{"type":"integer","minimum":50,"maximum":60000}}},
    "slo_policy_refs":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":160}},"incident_owner":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"rollback_target_ref":{"type":"string","minLength":3,"maxLength":160},"plan_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}
  }
}
