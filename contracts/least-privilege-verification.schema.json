{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/least-privilege-verification.schema.json",
  "title": "least-privilege-verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "storage_actions",
    "kms_actions",
    "resource_patterns",
    "violations",
    "status",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "verification_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "storage_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kms_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
