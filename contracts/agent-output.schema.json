{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/agent-output.schema.json",
  "title": "AgentOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "business_id",
    "agent",
    "status",
    "started_at",
    "finished_at",
    "inputs",
    "output",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "business_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_review"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "content_hash"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "business-truth",
              "vertical-recipe",
              "brand-profile",
              "site-config",
              "site-snapshot"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
            "maxLength": 300
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "output": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "document"
          ],
          "properties": {
            "kind": {
              "const": "business-truth"
            },
            "document": {
              "$ref": "https://schemas.hazlocrecer.com/business-truth.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "document"
          ],
          "properties": {
            "kind": {
              "const": "vertical-recipe"
            },
            "document": {
              "$ref": "https://schemas.hazlocrecer.com/vertical-recipe.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "document"
          ],
          "properties": {
            "kind": {
              "const": "brand-profile"
            },
            "document": {
              "$ref": "https://schemas.hazlocrecer.com/brand-profile.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "document"
          ],
          "properties": {
            "kind": {
              "const": "site-config"
            },
            "document": {
              "$ref": "https://schemas.hazlocrecer.com/site-config.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "document"
          ],
          "properties": {
            "kind": {
              "const": "site-snapshot"
            },
            "document": {
              "$ref": "https://schemas.hazlocrecer.com/site-snapshot.schema.json"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "POLICY_BLOCKED",
                "DEPENDENCY_FAILED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "needs_review"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
