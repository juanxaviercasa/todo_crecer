{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/smoke-test-result.schema.json",
  "title": "smoke-test-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "suite_ref",
    "promotion_ref",
    "checks",
    "passed",
    "failed",
    "status",
    "external_changes",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "suite_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "promotion_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence_digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "external_changes": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
