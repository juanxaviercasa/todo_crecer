{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-conformance-scorecard.schema.json",
  "title": "provider-conformance-scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scorecard_id",
    "candidate_ref",
    "dimensions",
    "score",
    "mandatory_pass",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scorecard_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "weight",
          "passed",
          "points"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "passed": {
            "type": "boolean"
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "mandatory_pass": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "eligible",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
