{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase42-reversal-plan.schema.json",
  "title": "phase42-reversal-plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    },
    "dry_run": {
      "type": "boolean",
      "const": true
    },
    "external_changes": {
      "type": "boolean",
      "const": false
    },
    "status": {
      "type": "string",
      "enum": [
        "prepared",
        "executed_simulated"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "decision_ref",
    "steps",
    "dry_run",
    "external_changes",
    "status",
    "created_at"
  ]
}
