{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/private-vault-record.schema.json","title":"PrivateVaultRecord","type":"object","additionalProperties":false,
  "required":["schema_version","record_id","tenant_id","record_type","algorithm","iv","auth_tag","ciphertext","plaintext_sha256","retention","created_at","updated_at"],
  "properties":{
    "schema_version":{"const":"0.1.0"},"record_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,100}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"record_type":{"enum":["owner_submission","business_truth","operator_review","asset_metadata","private_demo_manifest","consent_receipt","interaction_submission","lead_note"]},"algorithm":{"const":"aes-256-gcm"},
    "iv":{"type":"string","pattern":"^[A-Za-z0-9_-]{16}$"},"auth_tag":{"type":"string","pattern":"^[A-Za-z0-9_-]{22}$"},"ciphertext":{"type":"string","minLength":2},"plaintext_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "retention":{"type":"object","additionalProperties":false,"required":["class","expires_at","deletion_status"],"properties":{"class":{"enum":["active_pilot","inactive_lead","legal_hold"]},"expires_at":{"type":["string","null"],"format":"date-time"},"deletion_status":{"enum":["active","pending","deleted"]}}},
    "created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}
  }
}
