{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/privileged-operation.schema.json",
  "title": "privileged-operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "requester_ref",
    "capability",
    "resource",
    "risk",
    "required_approvals",
    "status",
    "requested_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "requester_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "capability": {
      "type": "string"
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "risk": {
      "enum": [
        "high",
        "critical"
      ]
    },
    "required_approvals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "executed",
        "rejected",
        "expired",
        "cancelled"
      ]
    },
    "justification": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
