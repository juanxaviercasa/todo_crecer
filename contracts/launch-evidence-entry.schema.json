{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/launch-evidence-entry.schema.json",
  "title": "launch-evidence-entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_id",
    "dossier_ref",
    "kind",
    "artifact_ref",
    "artifact_digest",
    "sanitized",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "dossier_ref": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "intent",
        "discovery",
        "reconciliation",
        "cost",
        "plan",
        "approvals",
        "authorization",
        "receipts",
        "smoke",
        "rollback",
        "credential_closure"
      ]
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sanitized": {
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
