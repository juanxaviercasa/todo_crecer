{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/staging-launch-plan.schema.json",
  "title": "staging-launch-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "intent_ref",
    "discovery_ref",
    "reconciliation_ref",
    "cost_ref",
    "actions",
    "plan_digest",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_ref": {
      "type": "string",
      "minLength": 1
    },
    "discovery_ref": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_ref": {
      "type": "string",
      "minLength": 1
    },
    "cost_ref": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "authorized",
        "applied",
        "verified",
        "rolled_back",
        "blocked",
        "closed"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
