{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/canary-activation-plan.schema.json",
  "title": "canary-activation-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canary_id",
    "plan_ref",
    "stages",
    "current_percent",
    "external_changes",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "canary_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "percent",
          "status",
          "success_gate"
        ],
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "rolled_back"
            ]
          },
          "success_gate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "current_percent": {
      "const": 0
    },
    "external_changes": {
      "const": false
    },
    "status": {
      "const": "planned"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
