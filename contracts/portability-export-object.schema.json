{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/portability-export-object.schema.json",
  "title": "portability-export-object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "manifest_ref",
    "object_ref",
    "ciphertext_digest",
    "metadata_digest",
    "key_ref",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "manifest_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "ciphertext_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "metadata_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "status": {
      "const": "exported"
    }
  }
}
