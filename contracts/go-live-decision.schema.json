{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/go-live-decision.schema.json","title":"GoLiveDecision","type":"object","additionalProperties":false,
  "required":["schema_version","decision_id","plan_id","plan_digest","tenant_id","area","decision","checks","reason_codes","actor","created_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"decision_id":{"type":"string","pattern":"^golived-[a-f0-9]{24}$"},"plan_id":{"type":"string","pattern":"^golivep-[a-f0-9]{24}$"},"plan_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"area":{"enum":["business","technical","operations","privacy"]},"decision":{"enum":["go","no_go"]},"checks":{"type":"array","minItems":2,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["key","status","evidence"],"properties":{"key":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,79}$"},"status":{"enum":["passed","failed"]},"evidence":{"type":"string","minLength":3,"maxLength":500}}}},"reason_codes":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"}},"actor":{"type":"object","additionalProperties":false,"required":["actor_id","role"],"properties":{"actor_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"role":{"enum":["owner","operator","admin"]}}},"created_at":{"type":"string","format":"date-time"}},
  "allOf":[{"if":{"properties":{"decision":{"const":"go"}}},"then":{"properties":{"reason_codes":{"maxItems":0},"checks":{"items":{"properties":{"status":{"const":"passed"}}}}}}},{"if":{"properties":{"decision":{"const":"no_go"}}},"then":{"properties":{"reason_codes":{"minItems":1}}}}]
}
