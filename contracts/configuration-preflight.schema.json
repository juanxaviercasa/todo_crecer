{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/configuration-preflight.schema.json",
  "title": "configuration-preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preflight_id",
    "environment_ref",
    "required_names",
    "present_names",
    "missing_names",
    "secret_values_persisted",
    "status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "preflight_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "required_names": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
      },
      "uniqueItems": true
    },
    "present_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "missing_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "secret_values_persisted": {
      "const": 0
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
