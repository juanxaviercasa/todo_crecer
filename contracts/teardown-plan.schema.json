{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/teardown-plan.schema.json",
  "title": "teardown-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "teardown_id",
    "environment_ref",
    "resource_refs",
    "retained_refs",
    "ordered_deletions",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "teardown_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "resource_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
      },
      "uniqueItems": true
    },
    "retained_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
      },
      "uniqueItems": true
    },
    "ordered_deletions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "simulated",
        "executed",
        "blocked"
      ]
    },
    "created_by": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
