{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/owner-consent-invitation.schema.json",
  "title": "owner-consent-invitation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invitation_id",
    "candidate_ref",
    "requested_declarations",
    "delivery_status",
    "external_message",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "invitation_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "requested_declarations": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_status": {
      "enum": [
        "draft",
        "sent",
        "expired",
        "declined",
        "accepted"
      ]
    },
    "external_message": {
      "const": false
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
