{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/candidate-decision-room-package.schema.json",
  "title": "candidate-decision-room-package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "board_ref",
    "candidate_refs",
    "review_refs",
    "evidence_mode",
    "selection_status",
    "selected_candidate_ref",
    "external_changes",
    "sealed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "board_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "review_refs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "evidence_mode": {
      "enum": [
        "placeholder",
        "mixed",
        "real"
      ]
    },
    "selection_status": {
      "enum": [
        "blocked",
        "ready_for_human_decision"
      ]
    },
    "selected_candidate_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9_-]{3,96}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_changes": {
      "const": false
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
