{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/delivery-attempt.schema.json","title":"DeliveryAttempt","type":"object","additionalProperties":false,
  "required":["schema_version","attempt_id","tenant_id","case_id","event_ref","provider","destination_ref","idempotency_key","payload_sha256","status","attempt_count","created_at","updated_at","provider_reference","error_code"],
  "properties":{"schema_version":{"const":"0.1.0"},"attempt_id":{"type":"string","pattern":"^delivery-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"case_id":{"type":"string","pattern":"^case-[a-f0-9]{24}$"},"event_ref":{"type":"string","pattern":"^levt-[a-f0-9]{24}$"},"provider":{"enum":["local_outbox","email_adapter","whatsapp_adapter","crm_adapter"]},"destination_ref":{"type":"string","pattern":"^[a-z0-9][a-z0-9:_-]{2,119}$"},"idempotency_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},"payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["queued","delivered","failed"]},"attempt_count":{"type":"integer","minimum":1,"maximum":10},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"provider_reference":{"type":["string","null"],"maxLength":200},"error_code":{"type":["string","null"],"pattern":"^[A-Z0-9_]{2,80}$"}}
}
