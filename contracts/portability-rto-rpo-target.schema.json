{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/portability-rto-rpo-target.schema.json",
  "title": "portability-rto-rpo-target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_id",
    "rto_minutes",
    "rpo_minutes",
    "measured_rto_minutes",
    "measured_rpo_minutes",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "rto_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "rpo_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "measured_rto_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "measured_rpo_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
