{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/staging-rollback-plan.schema.json",
  "title": "staging-rollback-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rollback_id",
    "plan_ref",
    "trigger",
    "steps",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "rollback_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "enum": [
        "manual",
        "smoke_failure",
        "slo_breach"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "executed"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
