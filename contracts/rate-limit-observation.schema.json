{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/rate-limit-observation.schema.json",
  "title": "rate-limit-observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "session_ref",
    "remaining",
    "limit",
    "window_seconds",
    "action",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "session_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "remaining": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "window_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "continue",
        "throttle",
        "stop"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
