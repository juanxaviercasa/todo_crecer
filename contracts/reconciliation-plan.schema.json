{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/reconciliation-plan.schema.json","title":"ReconciliationPlan","type":"object","additionalProperties":false,"required":["schema_version","plan_id","tenant_id","site_id","desired_state_ref","observed_state_ref","drift_keys","operations","idempotency_base","status","external_changes","created_at"],"properties":{"schema_version":{"const":"0.1.0"},"plan_id":{"type":"string","pattern":"^reconp-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"desired_state_ref":{"type":"string","pattern":"^desired-[a-f0-9]{24}$"},"observed_state_ref":{"type":"string","pattern":"^observed-[a-f0-9]{24}$"},"drift_keys":{"type":"array","maxItems":10,"uniqueItems":true,"items":{"enum":["recipe","design","engine","configuration","generation"]}},"operations":{"type":"array","maxItems":10,"uniqueItems":true,"items":{"enum":["apply_recipe","apply_design","apply_engine","apply_configuration","verify_state"]}},"idempotency_base":{"type":"string","pattern":"^[a-z0-9][a-z0-9:._-]{7,159}$"},"status":{"enum":["no_op","ready","blocked"]},"external_changes":{"const":false},"created_at":{"type":"string","format":"date-time"}}}
