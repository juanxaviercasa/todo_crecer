{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/staging-environment.schema.json",
  "title": "staging-environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "provider",
    "region_policy",
    "data_classification",
    "status",
    "external_changes_allowed",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "provider": {
      "enum": [
        "cloudflare",
        "local-synthetic"
      ]
    },
    "region_policy": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "data_classification": {
      "const": "synthetic"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "active",
        "suspended",
        "destroyed"
      ]
    },
    "external_changes_allowed": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
