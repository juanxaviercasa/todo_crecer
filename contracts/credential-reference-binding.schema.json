{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/credential-reference-binding.schema.json",
  "title": "credential-reference-binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "adapter_ref",
    "references",
    "material_present",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "adapter_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_reference",
          "fingerprint"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "source_reference": {
            "type": "string",
            "pattern": "^(env|secret|workload)://[a-zA-Z0-9_./-]+$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "material_present": {
      "const": false
    },
    "status": {
      "const": "reference_only"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
