{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/portability-failover-drill.schema.json",
  "title": "portability-failover-drill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "drill_id",
    "source_adapter",
    "target_adapter",
    "route_ref",
    "rto_rpo_ref",
    "integrity_ref",
    "rollback_verified",
    "status",
    "external_changes",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "drill_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "source_adapter": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "target_adapter": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "route_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "rto_rpo_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "integrity_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "rollback_verified": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "external_changes": {
      "const": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
