{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/asset-intake-record.schema.json",
  "title": "asset-intake-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "case_ref",
    "kind",
    "file_digest",
    "rights_declaration",
    "review_status",
    "received_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "kind": {
      "enum": [
        "logo",
        "portrait",
        "team",
        "property",
        "project",
        "document"
      ]
    },
    "file_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rights_declaration": {
      "enum": [
        "owned",
        "licensed",
        "permission_granted"
      ]
    },
    "review_status": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "alt_text": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
