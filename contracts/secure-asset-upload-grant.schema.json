{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/secure-asset-upload-grant.schema.json",
  "title": "secure-asset-upload-grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "case_ref",
    "token_hash",
    "allowed_kinds",
    "max_files",
    "status",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "token_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowed_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "logo",
          "portrait",
          "team",
          "property",
          "project",
          "document"
        ]
      }
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "status": {
      "enum": [
        "issued",
        "used",
        "revoked",
        "expired"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
