{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-identity-assertion.schema.json",
  "title": "owner-identity-assertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assertion_id",
    "room_ref",
    "identity_mode",
    "representative_name",
    "authority_basis",
    "synthetic",
    "status",
    "asserted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assertion_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "room_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "identity_mode": {
      "enum": [
        "synthetic",
        "verified_real"
      ]
    },
    "representative_name": {
      "type": "string",
      "minLength": 1
    },
    "authority_basis": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "verified_synthetic",
        "verified_real",
        "rejected"
      ]
    },
    "asserted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
