{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/invitation-dispatch-plan.schema.json",
  "title": "invitation-dispatch-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "case_ref",
    "draft_ref",
    "approval_ref",
    "destination_mode",
    "external_message",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "draft_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "approval_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "destination_mode": {
      "const": "owner_supplied_required"
    },
    "destination_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_message": {
      "const": false
    },
    "status": {
      "const": "waiting_authorization"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
