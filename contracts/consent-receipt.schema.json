{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.hazlocrecer.com/consent-receipt.schema.json",
  "title":"ConsentReceipt",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","consent_id","tenant_id","purpose","notice_version","lawful_basis","channels","statements","capture","status"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "consent_id":{"type":"string","pattern":"^cons-[a-f0-9]{24}$"},
    "tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "purpose":{"enum":["contact_request","property_interest","valuation_request"]},
    "notice_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"},
    "lawful_basis":{"const":"consent"},
    "channels":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["email","phone","whatsapp"]}},
    "statements":{"type":"object","additionalProperties":false,"required":["privacy_notice_accepted","contact_authorized","marketing_authorized"],"properties":{"privacy_notice_accepted":{"const":true},"contact_authorized":{"const":true},"marketing_authorized":{"type":"boolean"}}},
    "capture":{"type":"object","additionalProperties":false,"required":["occurred_at","ip_hmac","user_agent_hash","source_page"],"properties":{"occurred_at":{"type":"string","format":"date-time"},"ip_hmac":{"type":"string","pattern":"^[a-f0-9]{64}$"},"user_agent_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_page":{"type":"string","pattern":"^/[A-Za-z0-9/_-]*$","maxLength":200}}},
    "status":{"enum":["active","withdrawn"]},
    "withdrawn_at":{"type":["string","null"],"format":"date-time"}
  },
  "allOf":[{"if":{"properties":{"status":{"const":"withdrawn"}}},"then":{"required":["withdrawn_at"],"properties":{"withdrawn_at":{"type":"string"}}},"else":{"properties":{"withdrawn_at":{"const":null}}}}]
}
