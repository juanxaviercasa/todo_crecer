{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/evidence-case.schema.json",
  "title": "evidence-case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "candidate_ref",
    "mode",
    "access",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "mode": {
      "enum": [
        "synthetic_rehearsal",
        "real_private"
      ]
    },
    "access": {
      "const": "private"
    },
    "status": {
      "enum": [
        "open",
        "review",
        "sealed",
        "expired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
