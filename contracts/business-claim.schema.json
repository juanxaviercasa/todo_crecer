{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/business-claim.schema.json","title":"BusinessClaim","type":"object","additionalProperties":false,
  "required":["schema_version","claim_id","tenant_id","business_id","claimant_id","status","evidence","submitted_at","verified_at","reviewer_id","decision_reason","created_at","updated_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"claim_id":{"type":"string","pattern":"^claim-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"business_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"claimant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"status":{"enum":["draft","submitted","evidence_pending","verified","rejected","revoked"]},"evidence":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["evidence_id","kind","artifact_sha256","collected_at","verification_status","reviewer_id","review_note"],"properties":{"evidence_id":{"type":"string","pattern":"^evidence-[a-f0-9]{24}$"},"kind":{"enum":["domain_control","business_email","official_document","phone_callback","owner_invite","in_person"]},"artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"collected_at":{"type":"string","format":"date-time"},"verification_status":{"enum":["pending","accepted","rejected"]},"reviewer_id":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"review_note":{"type":["string","null"],"maxLength":500}}}},"submitted_at":{"type":["string","null"],"format":"date-time"},"verified_at":{"type":["string","null"],"format":"date-time"},"reviewer_id":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"decision_reason":{"type":["string","null"],"maxLength":500},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},
  "allOf":[{"if":{"properties":{"status":{"enum":["submitted","evidence_pending","verified"]}}},"then":{"properties":{"evidence":{"minItems":2},"submitted_at":{"type":"string"}}}},{"if":{"properties":{"status":{"const":"verified"}}},"then":{"properties":{"verified_at":{"type":"string"},"reviewer_id":{"type":"string"},"decision_reason":{"type":"string","minLength":5}}}},{"if":{"properties":{"status":{"enum":["rejected","revoked"]}}},"then":{"properties":{"reviewer_id":{"type":"string"},"decision_reason":{"type":"string","minLength":5}}}}]
}
