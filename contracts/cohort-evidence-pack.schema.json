{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/cohort-evidence-pack.schema.json",
  "title": "cohort-evidence-pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "cohort_ref",
    "entries",
    "external_messages",
    "publications",
    "evidence_digest",
    "sealed_by",
    "sealed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "cohort_ref": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "artifact_ref",
          "artifact_digest",
          "sanitized"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sanitized": {
            "const": true
          }
        }
      }
    },
    "external_messages": {
      "const": 0
    },
    "publications": {
      "const": 0
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sealed_by": {
      "type": "string",
      "minLength": 1
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
