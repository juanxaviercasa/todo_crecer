{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/operation-approval.schema.json",
  "title": "operation-approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "operation_ref",
    "approver_ref",
    "decision",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "operation_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "approver_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "comment": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
