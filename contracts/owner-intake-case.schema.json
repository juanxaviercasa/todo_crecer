{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-intake-case.schema.json",
  "title": "owner-intake-case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "candidate_ref",
    "public_name",
    "district",
    "status",
    "external_messages",
    "publications",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "public_name": {
      "type": "string",
      "minLength": 1
    },
    "district": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "outreach_ready",
        "awaiting_owner",
        "intake",
        "review",
        "acceptance",
        "ready",
        "declined",
        "expired",
        "blocked"
      ]
    },
    "external_messages": {
      "const": 0
    },
    "publications": {
      "const": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
