{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/portal-audit-event.schema.json","title":"PortalAuditEvent","type":"object","additionalProperties":false,
  "required":["schema_version","sequence","event_id","session_ref","principal_id","tenant_id","action","resource_ref","outcome","occurred_at","previous_hash","event_hash","signature"],
  "properties":{"schema_version":{"const":"0.1.0"},"sequence":{"type":"integer","minimum":1},"event_id":{"type":"string","pattern":"^paudit-[a-f0-9]{24}$"},"session_ref":{"type":["string","null"],"pattern":"^session-[a-f0-9]{24}$"},"principal_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"action":{"enum":["session.created","session.reauthenticated","session.revoked","dashboard.read","contact.revealed","preferences.updated","privacy.submitted","privacy.transitioned","business_change.submitted","business_change.reviewed","access.denied"]},"resource_ref":{"type":"string","pattern":"^[a-z0-9][a-z0-9:_-]{2,159}$"},"outcome":{"enum":["success","denied"]},"occurred_at":{"type":"string","format":"date-time"},"previous_hash":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"event_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"signature":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
