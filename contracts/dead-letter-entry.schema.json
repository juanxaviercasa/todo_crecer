{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/dead-letter-entry.schema.json","title":"DeadLetterEntry","type":"object","additionalProperties":false,"required":["schema_version","entry_id","tenant_id","job_ref","failure_code","safe_summary","attempts","replay_allowed","status","created_at","resolved_at"],"properties":{"schema_version":{"const":"0.1.0"},"entry_id":{"type":"string","pattern":"^dlq-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"job_ref":{"type":"string","pattern":"^job-[a-f0-9]{24}$"},"failure_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,79}$"},"safe_summary":{"type":"string","minLength":5,"maxLength":240},"attempts":{"type":"integer","minimum":1,"maximum":100},"replay_allowed":{"type":"boolean"},"status":{"enum":["open","replayed","discarded"]},"created_at":{"type":"string","format":"date-time"},"resolved_at":{"type":["string","null"],"format":"date-time"}}}
