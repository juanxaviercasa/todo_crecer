{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/observed-state-record.schema.json","title":"ObservedStateRecord","type":"object","additionalProperties":false,"required":["schema_version","observed_state_id","tenant_id","site_id","generation","recipe_version_ref","design_version_ref","engine_version","configuration_digest","release_digest","observed_at"],"properties":{"schema_version":{"const":"0.1.0"},"observed_state_id":{"type":"string","pattern":"^observed-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"generation":{"type":"integer","minimum":0},"recipe_version_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"design_version_ref":{"type":"string","pattern":"^dsv-[a-f0-9]{24}$"},"engine_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"configuration_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"release_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"observed_at":{"type":"string","format":"date-time"}}}
