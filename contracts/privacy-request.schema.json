{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/privacy-request.schema.json","title":"PrivacyRequest","type":"object","additionalProperties":false,
  "required":["schema_version","request_id","tenant_id","principal_id","type","scope","subject_ref","status","verification_ref","rejection_reason","due_at","created_at","updated_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"request_id":{"type":"string","pattern":"^privacy-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"principal_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"type":{"enum":["access","correction","withdrawal","deletion"]},"scope":{"enum":["contact_data","consent","marketing","all_private_records"]},"subject_ref":{"type":"string","pattern":"^[a-z0-9][a-z0-9:_-]{2,119}$"},"status":{"enum":["submitted","identity_pending","verified","processing","completed","rejected"]},"verification_ref":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9:_-]{2,119}$"},"rejection_reason":{"type":["string","null"],"maxLength":300},"due_at":{"type":"string","format":"date-time"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},
  "allOf":[{"if":{"properties":{"status":{"enum":["verified","processing","completed"]}}},"then":{"properties":{"verification_ref":{"type":"string"}}}},{"if":{"properties":{"status":{"const":"rejected"}}},"then":{"properties":{"rejection_reason":{"type":"string","minLength":5}}},"else":{"properties":{"rejection_reason":{"const":null}}}}]
}
