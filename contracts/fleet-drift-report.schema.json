{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/fleet-drift-report.schema.json","title":"FleetDriftReport","type":"object","additionalProperties":false,"required":["schema_version","drift_id","tenant_id","site_id","asset_type","expected_digest","observed_digest","severity","recommended_action","status","detected_at","resolved_at"],"properties":{"schema_version":{"const":"0.1.0"},"drift_id":{"type":"string","pattern":"^drift-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"asset_type":{"enum":["recipe","design","engine","configuration"]},"expected_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"observed_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"severity":{"enum":["none","low","medium","high","critical"]},"recommended_action":{"enum":["no_action","reconcile","pause","rollback"]},"status":{"enum":["open","resolved"]},"detected_at":{"type":"string","format":"date-time"},"resolved_at":{"type":["string","null"],"format":"date-time"}}}
