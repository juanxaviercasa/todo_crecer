{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/orchestration-job.schema.json","title":"OrchestrationJob","type":"object","additionalProperties":false,"required":["schema_version","job_id","tenant_id","site_id","operation","idempotency_key","payload_digest","desired_state_ref","status","priority","attempts","max_attempts","cost_units","available_at","lease_ref","created_at","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"job_id":{"type":"string","pattern":"^job-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"operation":{"enum":["apply_recipe","apply_design","apply_engine","apply_configuration","verify_state","rollback"]},"idempotency_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9:._-]{7,159}$"},"payload_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"desired_state_ref":{"type":"string","pattern":"^desired-[a-f0-9]{24}$"},"status":{"enum":["queued","leased","retry_scheduled","succeeded","failed","dead_lettered","cancelled"]},"priority":{"type":"integer","minimum":0,"maximum":100},"attempts":{"type":"integer","minimum":0,"maximum":100},"max_attempts":{"type":"integer","minimum":1,"maximum":100},"cost_units":{"type":"integer","minimum":1,"maximum":10000},"available_at":{"type":"string","format":"date-time"},"lease_ref":{"type":["string","null"],"pattern":"^lease-[a-f0-9]{24}$"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
