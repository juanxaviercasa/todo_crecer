{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase31-readiness.schema.json",
  "title": "phase31-readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "scenarios",
    "passed_safety_checks",
    "live_contact_allowed",
    "status",
    "blockers",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "readiness_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "scenarios": {
      "type": "integer",
      "minimum": 5
    },
    "passed_safety_checks": {
      "type": "integer",
      "minimum": 1
    },
    "live_contact_allowed": {
      "const": false
    },
    "status": {
      "enum": [
        "simulation_complete",
        "blocked",
        "failed"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
