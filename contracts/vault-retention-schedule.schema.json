{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-retention-schedule.schema.json",
  "title": "vault-retention-schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedule_id",
    "object_ref",
    "retention_days",
    "expires_at",
    "action",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "schedule_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "retention_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "enum": [
        "review",
        "destroy"
      ]
    },
    "status": {
      "enum": [
        "active",
        "due",
        "completed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
