{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/subscription-state.schema.json","title":"SubscriptionState","type":"object","additionalProperties":false,
  "required":["schema_version","subscription_id","tenant_id","plan_ref","provider","external_customer_ref","status","trial_ends_at","period_ends_at","cancel_at_period_end","last_event_at","version","created_at","updated_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"subscription_id":{"type":"string","pattern":"^subscription-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"plan_ref":{"type":["string","null"],"pattern":"^plan-[a-z0-9-]{2,60}$"},"provider":{"enum":["unconfigured","local_sandbox","billing_adapter"]},"external_customer_ref":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9:_-]{2,119}$"},"status":{"enum":["no_subscription","trialing","active","past_due","suspended","cancelled"]},"trial_ends_at":{"type":["string","null"],"format":"date-time"},"period_ends_at":{"type":["string","null"],"format":"date-time"},"cancel_at_period_end":{"type":"boolean"},"last_event_at":{"type":["string","null"],"format":"date-time"},"version":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}
}
