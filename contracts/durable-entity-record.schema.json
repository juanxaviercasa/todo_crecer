{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/durable-entity-record.schema.json","title":"DurableEntityRecord","type":"object","additionalProperties":false,"required":["schema_version","tenant_id","entity_type","entity_id","version","payload_digest","transaction_ref","created_at","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"entity_type":{"enum":["desired_state","observed_state","job","lease","budget","idempotency","dead_letter","fleet_site"]},"entity_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9:._-]{2,159}$"},"version":{"type":"integer","minimum":1},"payload_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"transaction_ref":{"type":"string","pattern":"^cptx-[a-f0-9]{24}$"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
