{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/authorization-policy.schema.json",
  "title": "authorization-policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "status",
    "capabilities",
    "environments",
    "maximum_risk",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "environments": {
      "type": "array",
      "items": {
        "enum": [
          "local",
          "development",
          "staging",
          "production"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "maximum_risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "require_mfa": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
