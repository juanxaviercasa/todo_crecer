{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/events/agent.failed.schema.json",
  "title": "agent.failed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "businessid",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "pattern": "^urn:todolima:"
    },
    "type": {
      "const": "com.hazlocrecer.agent.failed.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "https://schemas.hazlocrecer.com/events/agent.failed.schema.json"
    },
    "correlationid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causationid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "businessid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_hash",
        "document"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "document": {
          "$ref": "https://schemas.hazlocrecer.com/agent-output.schema.json",
          "allOf": [
            {
              "properties": {
                "status": {
                  "const": "failed"
                }
              },
              "required": [
                "status"
              ]
            }
          ]
        }
      }
    }
  }
}
