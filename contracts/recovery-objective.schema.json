{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/recovery-objective.schema.json","title":"RecoveryObjective","type":"object","additionalProperties":false,"required":["schema_version","objective_id","name","rpo_seconds","rto_seconds","maximum_lost_transactions","approved_by","approved_at"],"properties":{"schema_version":{"const":"0.1.0"},"objective_id":{"type":"string","pattern":"^robj-[a-f0-9]{24}$"},"name":{"type":"string","minLength":3,"maxLength":120},"rpo_seconds":{"type":"integer","minimum":0,"maximum":604800},"rto_seconds":{"type":"integer","minimum":1,"maximum":604800},"maximum_lost_transactions":{"type":"integer","minimum":0,"maximum":1000000},"approved_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"approved_at":{"type":"string","format":"date-time"}}}
