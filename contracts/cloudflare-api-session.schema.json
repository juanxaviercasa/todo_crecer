{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/cloudflare-api-session.schema.json",
  "title": "cloudflare-api-session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "mode",
    "token_fingerprint",
    "account_fingerprint",
    "zone_fingerprint",
    "status",
    "secret_persisted",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "mode": {
      "enum": [
        "read",
        "apply"
      ]
    },
    "token_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "account_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "zone_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "active",
        "expired",
        "revoked",
        "invalid"
      ]
    },
    "secret_persisted": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
