{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/evidence-review-decision.schema.json",
  "title": "evidence-review-decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "encryption_ref",
    "reviewer_ref",
    "role",
    "decision",
    "checks",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "encryption_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "reviewer_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "role": {
      "enum": [
        "privacy_reviewer",
        "business_reviewer"
      ]
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
