{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/owner-confirmation-record.schema.json",
  "title": "owner-confirmation-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "confirmation_id",
    "candidate_ref",
    "owner_evidence_digest",
    "acknowledgements",
    "confirmed_by",
    "status",
    "confirmed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "confirmation_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acknowledgements": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "business_name",
          "services",
          "service_area",
          "contact_channel",
          "image_rights",
          "publication_scope"
        ]
      }
    },
    "confirmed_by": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "confirmed"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
