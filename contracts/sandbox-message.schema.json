{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/sandbox-message.schema.json",
  "title": "sandbox-message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "case_ref",
    "direction",
    "kind",
    "body",
    "sandbox",
    "external_delivery",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "direction": {
      "enum": [
        "outbound",
        "inbound"
      ]
    },
    "kind": {
      "enum": [
        "invitation",
        "reminder",
        "question",
        "answer",
        "decision"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "sandbox": {
      "const": true
    },
    "external_delivery": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
