{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/credential-closure.schema.json",
  "title": "credential-closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure_id",
    "intent_ref",
    "read_session_closed",
    "apply_session_closed",
    "credential_fingerprints",
    "status",
    "closed_by",
    "closed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "closure_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_ref": {
      "type": "string",
      "minLength": 1
    },
    "read_session_closed": {
      "type": "boolean"
    },
    "apply_session_closed": {
      "type": "boolean"
    },
    "credential_fingerprints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "closed_by": {
      "type": "string",
      "minLength": 1
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
