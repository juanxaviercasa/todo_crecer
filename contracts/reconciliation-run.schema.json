{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/reconciliation-run.schema.json","title":"ReconciliationRun","type":"object","additionalProperties":false,"required":["schema_version","run_id","tenant_id","total_sites","no_op_sites","ready_sites","blocked_sites","jobs_enqueued","duplicates_suppressed","budget_ref","status","dry_run","created_by","created_at"],"properties":{"schema_version":{"const":"0.1.0"},"run_id":{"type":"string","pattern":"^reconr-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"total_sites":{"type":"integer","minimum":0},"no_op_sites":{"type":"integer","minimum":0},"ready_sites":{"type":"integer","minimum":0},"blocked_sites":{"type":"integer","minimum":0},"jobs_enqueued":{"type":"integer","minimum":0},"duplicates_suppressed":{"type":"integer","minimum":0},"budget_ref":{"type":"string","pattern":"^budget-[a-f0-9]{24}$"},"status":{"enum":["planned","partially_enqueued","enqueued"]},"dry_run":{"const":true},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"}}}
