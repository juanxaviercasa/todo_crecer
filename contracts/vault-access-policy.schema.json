{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-access-policy.schema.json",
  "title": "vault-access-policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "vault_ref",
    "allowed_scopes",
    "max_ttl_minutes",
    "max_uses",
    "watermark_required",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "vault_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "allowed_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "view",
          "export",
          "review"
        ]
      }
    },
    "max_ttl_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "watermark_required": {
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
