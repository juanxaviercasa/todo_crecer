{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/business-change-request.schema.json","title":"BusinessChangeRequest","type":"object","additionalProperties":false,
  "required":["schema_version","change_id","tenant_id","business_id","requested_by","base_truth_sha256","operations","reason","status","reviewer_id","review_reason","created_at","updated_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"change_id":{"type":"string","pattern":"^change-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"business_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"requested_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"base_truth_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"operations":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["op","path","value"],"properties":{"op":{"const":"replace"},"path":{"enum":["/identity/display_name","/description","/contact/public_phone","/contact/public_email","/contact/website","/hours/summary"]},"value":{"type":"string","minLength":1,"maxLength":500}}}},"reason":{"type":"string","minLength":5,"maxLength":500},"status":{"enum":["submitted","approved","rejected","superseded"]},"reviewer_id":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"review_reason":{"type":["string","null"],"maxLength":500},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},
  "allOf":[{"if":{"properties":{"status":{"const":"submitted"}}},"then":{"properties":{"reviewer_id":{"const":null},"review_reason":{"const":null}}},"else":{"properties":{"reviewer_id":{"type":"string"},"review_reason":{"type":"string","minLength":5}}}}]
}
