{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/watermarked-vault-export.schema.json",
  "title": "watermarked-vault-export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "object_ref",
    "grant_ref",
    "subject_ref",
    "watermark",
    "export_digest",
    "raw_content_returned",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "grant_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "watermark": {
      "type": "string",
      "minLength": 1
    },
    "export_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_content_returned": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
