{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase44-integrity-baseline.schema.json",
  "title": "phase44-integrity-baseline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_digest": {
      "type": "string",
      "minLength": 1
    },
    "target_expected_digest": {
      "type": "string",
      "minLength": 1
    },
    "mismatch_tolerance": {
      "type": "integer",
      "const": 0
    },
    "status": {
      "type": "string",
      "const": "sealed"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "baseline_id",
    "plan_ref",
    "object_count",
    "source_digest",
    "target_expected_digest",
    "mismatch_tolerance",
    "status",
    "created_at"
  ]
}
