{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-migration-plan.schema.json",
  "title": "vault-migration-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "object_count",
    "batch_size",
    "batch_count",
    "source_digest",
    "target_digest",
    "dry_run",
    "apply_executed",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "object_count": {
      "type": "integer",
      "minimum": 1
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "batch_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dry_run": {
      "const": true
    },
    "apply_executed": {
      "const": false
    },
    "status": {
      "enum": [
        "validated",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
