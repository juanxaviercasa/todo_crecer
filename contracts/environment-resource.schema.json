{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/environment-resource.schema.json",
  "title": "environment-resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_id",
    "environment_ref",
    "kind",
    "logical_name",
    "desired_digest",
    "depends_on",
    "lifecycle",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "kind": {
      "enum": [
        "worker",
        "d1",
        "r2",
        "queue",
        "service_binding",
        "secrets_store",
        "observability",
        "custom_hostname"
      ]
    },
    "logical_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
    },
    "desired_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
      },
      "uniqueItems": true
    },
    "lifecycle": {
      "enum": [
        "managed",
        "shared",
        "retain"
      ]
    },
    "status": {
      "enum": [
        "declared",
        "planned",
        "ready",
        "drifted",
        "destroyed"
      ]
    }
  }
}
