{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.hazlocrecer.com/pilot-dossier.schema.json",
  "title":"PilotDossier",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","dossier_id","tenant_id","business_id","site_id","revision","synthetic","status","source_refs","requirements","snapshot_hash","created_by","created_at","updated_at"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "dossier_id":{"type":"string","pattern":"^pilotd-[a-f0-9]{24}$"},
    "tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "business_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "revision":{"type":"integer","minimum":1},
    "synthetic":{"type":"boolean"},
    "status":{"enum":["draft","in_review","changes_requested","accepted","ready_for_rehearsal","sealed_local"]},
    "source_refs":{
      "type":"object","additionalProperties":false,
      "required":["owner_submission","business_truth","brand_profile","site_config","site_snapshot","asset_registry","privacy_notice"],
      "properties":{
        "owner_submission":{"type":"string","minLength":3,"maxLength":160},
        "business_truth":{"type":"string","minLength":3,"maxLength":160},
        "brand_profile":{"type":"string","minLength":3,"maxLength":160},
        "site_config":{"type":"string","minLength":3,"maxLength":160},
        "site_snapshot":{"type":"string","minLength":3,"maxLength":160},
        "asset_registry":{"type":"string","minLength":3,"maxLength":160},
        "privacy_notice":{"type":"string","minLength":3,"maxLength":160}
      }
    },
    "requirements":{"type":"array","minItems":9,"maxItems":9,"items":{"$ref":"#/$defs/requirement"}},
    "snapshot_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  },
  "$defs":{
    "requirement":{
      "type":"object","additionalProperties":false,
      "required":["key","label","status","evidence_refs","blocker_code","updated_by","updated_at"],
      "properties":{
        "key":{"enum":["identity","brand","assets","copy","design","privacy","contact","domain","publication"]},
        "label":{"type":"string","minLength":3,"maxLength":160},
        "status":{"enum":["pending","ready","blocked"]},
        "evidence_refs":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":240}},
        "blocker_code":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
        "updated_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
        "updated_at":{"type":"string","format":"date-time"}
      },
      "allOf":[
        {"if":{"properties":{"status":{"const":"ready"}}},"then":{"properties":{"evidence_refs":{"minItems":1},"blocker_code":{"type":"null"}}}},
        {"if":{"properties":{"status":{"const":"blocked"}}},"then":{"properties":{"blocker_code":{"type":"string"}}}}
      ]
    }
  }
}
