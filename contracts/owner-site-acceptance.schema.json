{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/owner-site-acceptance.schema.json",
  "title": "owner-site-acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "candidate_ref",
    "variant_ref",
    "confirmation_ref",
    "rights_ref",
    "visual_review_ref",
    "conversion_review_ref",
    "acknowledgements",
    "accepted_by",
    "accepted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "acceptance_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "variant_ref": {
      "type": "string",
      "minLength": 1
    },
    "confirmation_ref": {
      "type": "string",
      "minLength": 1
    },
    "rights_ref": {
      "type": "string",
      "minLength": 1
    },
    "visual_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "conversion_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "acknowledgements": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accepted_by": {
      "type": "string",
      "minLength": 1
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
