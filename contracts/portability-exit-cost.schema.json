{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/portability-exit-cost.schema.json",
  "title": "portability-exit-cost",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estimate_id",
    "migration_cents",
    "egress_cents",
    "rekey_cents",
    "support_cents",
    "total_cents",
    "hard_limit_cents",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "estimate_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "migration_cents": {
      "type": "integer",
      "minimum": 0
    },
    "egress_cents": {
      "type": "integer",
      "minimum": 0
    },
    "rekey_cents": {
      "type": "integer",
      "minimum": 0
    },
    "support_cents": {
      "type": "integer",
      "minimum": 0
    },
    "total_cents": {
      "type": "integer",
      "minimum": 0
    },
    "hard_limit_cents": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "allow",
        "warning",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
