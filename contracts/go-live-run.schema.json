{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/go-live-run.schema.json","title":"GoLiveRun","type":"object","additionalProperties":false,
  "required":["schema_version","run_id","plan_id","plan_digest","tenant_id","execution_mode","status","current_stage_percent","observation_refs","hypercare_refs","rollback_ref","external_changes","external_messages","publication_performed","started_by","started_at","completed_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"run_id":{"type":"string","pattern":"^goliver-[a-f0-9]{24}$"},"plan_id":{"type":"string","pattern":"^golivep-[a-f0-9]{24}$"},"plan_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"execution_mode":{"const":"dry_run"},"status":{"enum":["running","hypercare","closed","rolled_back"]},"current_stage_percent":{"type":["integer","null"],"enum":[null,5,25,50,100]},"observation_refs":{"type":"array","maxItems":4,"uniqueItems":true,"items":{"type":"string","pattern":"^goliveo-[a-f0-9]{24}$"}},"hypercare_refs":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"type":"string","pattern":"^goliveh-[a-f0-9]{24}$"}},"rollback_ref":{"type":["string","null"],"pattern":"^goliveb-[a-f0-9]{24}$"},"external_changes":{"const":0},"external_messages":{"const":0},"publication_performed":{"const":false},"started_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"started_at":{"type":"string","format":"date-time"},"completed_at":{"type":["string","null"],"format":"date-time"}},
  "allOf":[{"if":{"properties":{"status":{"const":"closed"}}},"then":{"properties":{"current_stage_percent":{"const":100},"observation_refs":{"minItems":4},"hypercare_refs":{"minItems":3},"rollback_ref":{"type":"null"},"completed_at":{"type":"string"}}}},{"if":{"properties":{"status":{"const":"rolled_back"}}},"then":{"properties":{"rollback_ref":{"type":"string"},"completed_at":{"type":"string"}}}}]
}
