{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/recipe-learning-proposal.schema.json","title":"RecipeLearningProposal","type":"object","additionalProperties":false,"required":["schema_version","proposal_id","tenant_id","experiment_result_ref","source_site_id","target_archetype","recipe_ref","recommendations","evidence_refs","status","auto_publish","created_by","approved_by","created_at","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"proposal_id":{"type":"string","pattern":"^learnp-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"experiment_result_ref":{"type":"string","pattern":"^exptr-[a-f0-9]{24}$"},"source_site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"target_archetype":{"enum":["catalog","developer","advisor","projects","valuation"]},"recipe_ref":{"type":"string","minLength":3,"maxLength":160},"recommendations":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["component","change","risk"],"properties":{"component":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,79}$"},"change":{"type":"string","minLength":10,"maxLength":500},"risk":{"enum":["low","medium","high"]}}}},"evidence_refs":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":160}},"status":{"enum":["proposed","approved","rejected"]},"auto_publish":{"const":false},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"approved_by":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
