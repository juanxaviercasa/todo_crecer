{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/staging-rehearsal.schema.json",
  "title": "staging-rehearsal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rehearsal_id",
    "environment_ref",
    "plan_ref",
    "promotion_ref",
    "smoke_result_ref",
    "rollback_ref",
    "teardown_ref",
    "checks_total",
    "checks_passed",
    "external_changes",
    "status",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "rehearsal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "promotion_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "smoke_result_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "rollback_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "teardown_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "checks_total": {
      "type": "integer",
      "minimum": 1
    },
    "checks_passed": {
      "type": "integer",
      "minimum": 0
    },
    "external_changes": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
