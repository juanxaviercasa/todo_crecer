{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/vertical-recipe.schema.json",
  "title": "VerticalRecipe",
  "description": "Reglas declarativas para convertir BusinessTruth en una experiencia adecuada a un vertical sin codificar un sitio distinto por negocio.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "name", "verticals", "truth_requirements", "sections", "cta_policy", "seo_policy", "quality_policy"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-_]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "verticals": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 120}, "uniqueItems": true},
    "truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_paths", "prohibited_inventions"],
      "properties": {
        "minimum_paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true},
        "recommended_paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true},
        "prohibited_inventions": {"type": "array", "items": {"type": "string", "maxLength": 200}, "uniqueItems": true}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "priority", "enabled_by_default"],
        "properties": {
          "component": {"type": "string", "enum": ["hero", "services", "about", "gallery", "reviews", "team", "pricing", "faq", "map", "contact", "booking", "whatsapp_cta", "phone_cta", "hours", "footer", "custom"]},
          "priority": {"type": "integer", "minimum": 1, "maximum": 1000},
          "enabled_by_default": {"type": "boolean"},
          "requires_truth_paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true},
          "notes": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    },
    "cta_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_intents"],
      "properties": {
        "primary_intents": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["whatsapp", "phone", "form", "booking", "visit", "quote", "menu", "other"]}, "uniqueItems": true},
        "fallback_intent": {"type": ["string", "null"], "enum": ["whatsapp", "phone", "form", "booking", "visit", "quote", "menu", "other", null]}
      }
    },
    "design_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone_keywords": {"type": "array", "items": {"type": "string", "maxLength": 80}, "uniqueItems": true},
        "avoid_patterns": {"type": "array", "items": {"type": "string", "maxLength": 160}, "uniqueItems": true},
        "allowed_layout_families": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true}
      }
    },
    "seo_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demo_indexing", "structured_data_types"],
      "properties": {
        "demo_indexing": {"type": "string", "const": "noindex"},
        "structured_data_types": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true}
      }
    },
    "quality_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_soft_score"],
      "properties": {
        "minimum_soft_score": {"type": "integer", "minimum": 0, "maximum": 100, "default": 80},
        "required_hard_gates": {"type": "array", "items": {"type": "string", "maxLength": 120}, "uniqueItems": true}
      }
    }
  }
}
