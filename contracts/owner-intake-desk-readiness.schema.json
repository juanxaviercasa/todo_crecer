{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-intake-desk-readiness.schema.json",
  "title": "owner-intake-desk-readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "case_states",
    "counts",
    "external_messages",
    "publications",
    "status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "readiness_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_ref",
          "status",
          "next_action"
        ],
        "properties": {
          "case_ref": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "external_messages": {
      "const": 0
    },
    "publications": {
      "const": 0
    },
    "status": {
      "enum": [
        "drafts_ready",
        "in_progress",
        "ready_for_handoff",
        "blocked"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
