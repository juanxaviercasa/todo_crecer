{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/assisted-contact-plan.schema.json",
  "title": "assisted-contact-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "selection_ref",
    "destination_ref",
    "script_ref",
    "authorization_ref",
    "mode",
    "operator_required",
    "external_delivery",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "selection_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "destination_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "script_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "authorization_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "mode": {
      "const": "human_assisted"
    },
    "operator_required": {
      "const": true
    },
    "external_delivery": {
      "const": false
    },
    "status": {
      "enum": [
        "blocked",
        "ready_for_human_send",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
