{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/staging-launch-readiness.schema.json",
  "title": "staging-launch-readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "intent_ref",
    "checks",
    "blockers",
    "status",
    "external_changes",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "readiness_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_ref": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "blocked",
        "launch_candidate",
        "applied_pending_verification",
        "verified",
        "rolled_back",
        "closed"
      ]
    },
    "external_changes": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
