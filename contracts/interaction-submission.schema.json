{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.hazlocrecer.com/interaction-submission.schema.json",
  "title":"InteractionSubmission",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","submission_id","tenant_id","site_id","purpose","contact","message","property_ref","consent_ref","privacy","anti_abuse","received_at"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "submission_id":{"type":"string","pattern":"^sub-[a-f0-9]{24}$"},
    "tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "purpose":{"enum":["contact_request","property_interest","valuation_request"]},
    "contact":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":2,"maxLength":100},"email":{"type":"string","format":"email","maxLength":254},"phone":{"type":"string","pattern":"^\\+?[0-9][0-9 ()-]{6,24}$"}},"anyOf":[{"required":["email"]},{"required":["phone"]}]},
    "message":{"type":["string","null"],"maxLength":1000},
    "property_ref":{"type":["string","null"],"pattern":"^[A-Za-z0-9_-]{2,80}$"},
    "consent_ref":{"type":"string","pattern":"^cons-[a-f0-9]{24}$"},
    "privacy":{"type":"object","additionalProperties":false,"required":["retention_class","delete_after","status"],"properties":{"retention_class":{"enum":["lead_90_days","valuation_180_days"]},"delete_after":{"type":"string","format":"date-time"},"status":{"const":"active"}}},
    "anti_abuse":{"type":"object","additionalProperties":false,"required":["decision","checks"],"properties":{"decision":{"const":"accepted"},"checks":{"type":"array","minItems":4,"uniqueItems":true,"items":{"enum":["honeypot_clear","minimum_time_met","rate_limit_clear","duplicate_clear","content_safe"]}}}},
    "received_at":{"type":"string","format":"date-time"}
  },
  "allOf":[{"if":{"properties":{"purpose":{"const":"property_interest"}}},"then":{"properties":{"property_ref":{"type":"string"}}}}]
}
