{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/professional-site-variant.schema.json",
  "title": "professional-site-variant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variant_id",
    "candidate_ref",
    "dossier_ref",
    "archetype",
    "design_family",
    "pages",
    "contact_mode",
    "indexing",
    "access",
    "claims_mode",
    "variant_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "dossier_ref": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "design_family": {
      "enum": [
        "editorial-advisor",
        "portfolio-agency",
        "data-consultancy",
        "local-market",
        "project-showcase"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contact_mode": {
      "enum": [
        "disabled",
        "owner_confirmed"
      ]
    },
    "indexing": {
      "const": "noindex"
    },
    "access": {
      "const": "private"
    },
    "claims_mode": {
      "enum": [
        "public_evidence_only",
        "owner_confirmed"
      ]
    },
    "variant_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
