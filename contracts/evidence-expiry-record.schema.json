{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/evidence-expiry-record.schema.json",
  "title": "evidence-expiry-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expiry_id",
    "evidence_ref",
    "expires_at",
    "action",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "expiry_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "enum": [
        "review",
        "destroy"
      ]
    },
    "status": {
      "enum": [
        "active",
        "due",
        "expired",
        "destroyed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
