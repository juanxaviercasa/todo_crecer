{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase42-human-decision.schema.json",
  "title": "phase42-human-decision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "legal_review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "procurement_review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reversible": {
      "type": "boolean",
      "const": true
    },
    "decision": {
      "type": "string",
      "enum": [
        "pending",
        "approved_reversible",
        "blocked"
      ]
    },
    "authorization": {
      "type": "string",
      "enum": [
        "none",
        "human_recorded"
      ]
    },
    "decided_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "candidate_id",
    "evidence_digest",
    "legal_review_ref",
    "procurement_review_ref",
    "session_ref",
    "reversible",
    "decision",
    "authorization",
    "decided_at"
  ]
}
