{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/owner-intake-checklist.schema.json",
  "title": "owner-intake-checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checklist_id",
    "candidate_ref",
    "requirements",
    "completed",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "checklist_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "pending",
        "complete"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
