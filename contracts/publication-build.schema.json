{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.hazlocrecer.com/publication-build.schema.json",
  "title":"PublicationBuild","type":"object","additionalProperties":false,
  "required":["schema_version","build_id","tenant_id","site_id","snapshot_id","artifact_digest","entrypoint","environment","qa_status","approval_status","registered_by","approved_by","approved_at","created_at"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "build_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,127}$"},
    "tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,127}$"},
    "snapshot_id":{"type":"string","minLength":3,"maxLength":128},
    "artifact_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "entrypoint":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$","maxLength":300},
    "environment":{"enum":["preview","production"]},
    "qa_status":{"const":"passed"},
    "approval_status":{"enum":["pending","approved","rejected","revoked"]},
    "registered_by":{"type":"string","minLength":3,"maxLength":128},
    "approved_by":{"type":["string","null"],"maxLength":128},
    "approved_at":{"type":["string","null"],"format":"date-time"},
    "created_at":{"type":"string","format":"date-time"}
  },
  "allOf":[{"if":{"properties":{"approval_status":{"const":"approved"}}},"then":{"properties":{"approved_by":{"type":"string","minLength":3},"approved_at":{"type":"string"}}}}]
}
