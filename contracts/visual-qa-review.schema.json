{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/visual-qa-review.schema.json",
  "title": "visual-qa-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "variant_ref",
    "viewports",
    "checks",
    "status",
    "reviewer_ref",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_ref": {
      "type": "string",
      "minLength": 1
    },
    "viewports": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "desktop",
          "mobile"
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "reviewer_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
