{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/product-plan.schema.json","title":"ProductPlan","type":"object","additionalProperties":false,
  "required":["schema_version","plan_id","plan_version","label","status","commercial_terms_ref","capabilities","created_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"plan_id":{"type":"string","pattern":"^plan-[a-z0-9-]{2,60}$"},"plan_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"label":{"type":"string","minLength":3,"maxLength":80},"status":{"enum":["draft","active","retired"]},"commercial_terms_ref":{"type":["string","null"],"maxLength":200},"capabilities":{"type":"array","minItems":1,"maxItems":30,"items":{"type":"object","additionalProperties":false,"required":["key","mode","limit"],"properties":{"key":{"enum":["portal.access","privacy.request","data.export.request","site.preview","site.publish","lead.capture","custom.domain","analytics.basic","content.change.request","asset.upload","multi.site"]},"mode":{"enum":["enabled","disabled","limited"]},"limit":{"type":["integer","null"],"minimum":1}}}},"created_at":{"type":"string","format":"date-time"}}
