{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-legal-hold.schema.json",
  "title": "vault-legal-hold",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hold_id",
    "object_ref",
    "reason",
    "status",
    "placed_by",
    "placed_at",
    "released_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "hold_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "released"
      ]
    },
    "placed_by": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "placed_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
