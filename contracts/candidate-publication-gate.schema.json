{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/candidate-publication-gate.schema.json",
  "title": "candidate-publication-gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "candidate_ref",
    "checks",
    "blockers",
    "status",
    "contact_enabled",
    "public_publish_allowed",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "blocked",
        "private_ready",
        "public_ready"
      ]
    },
    "contact_enabled": {
      "type": "boolean"
    },
    "public_publish_allowed": {
      "type": "boolean"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
