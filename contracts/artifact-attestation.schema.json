{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/artifact-attestation.schema.json",
  "title": "artifact-attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "artifact_name",
    "artifact_digest",
    "manifest_digest",
    "signer_ref",
    "key_ref",
    "environment",
    "signature",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "artifact_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signer_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "key_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "environment": {
      "enum": [
        "local",
        "development",
        "staging",
        "production"
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 40,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "verified",
        "revoked",
        "invalid"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
