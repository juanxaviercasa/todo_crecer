{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase42-decision-dossier.schema.json",
  "title": "phase42-decision-dossier",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "dossier_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2
    },
    "submission_count": {
      "type": "integer",
      "minimum": 0
    },
    "real_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "approved_reviews": {
      "type": "integer",
      "minimum": 0
    },
    "human_decisions": {
      "type": "integer",
      "minimum": 0
    },
    "selected_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "synthetic_rehearsal",
        "ready_for_human_decision",
        "approved_reversible"
      ]
    },
    "external_changes": {
      "type": "boolean",
      "const": false
    },
    "publications": {
      "type": "integer",
      "const": 0
    },
    "sealed_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "dossier_id",
    "candidate_ids",
    "submission_count",
    "real_evidence_count",
    "approved_reviews",
    "human_decisions",
    "selected_candidate",
    "status",
    "external_changes",
    "publications",
    "sealed_at"
  ]
}
