{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/rollback-trigger.schema.json","title":"RollbackTrigger","type":"object","additionalProperties":false,
  "required":["schema_version","trigger_id","run_id","plan_id","tenant_id","source","reason_codes","stage_percent","rollback_target_ref","status","external_changes","requested_by","created_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"trigger_id":{"type":"string","pattern":"^goliveb-[a-f0-9]{24}$"},"run_id":{"type":"string","pattern":"^goliver-[a-f0-9]{24}$"},"plan_id":{"type":"string","pattern":"^golivep-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"source":{"enum":["canary","hypercare","manual"]},"reason_codes":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"}},"stage_percent":{"type":["integer","null"],"enum":[null,5,25,50,100]},"rollback_target_ref":{"type":"string","minLength":3,"maxLength":160},"status":{"const":"simulated"},"external_changes":{"const":0},"requested_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"}}
}
