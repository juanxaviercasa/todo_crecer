{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/staging-smoke-suite.schema.json",
  "title": "staging-smoke-suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "plan_ref",
    "checks",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dns",
          "tls",
          "csp",
          "x_frame_options",
          "x_robots_tag",
          "worker_route",
          "d1_binding",
          "r2_binding",
          "queue_delivery",
          "secret_binding",
          "noindex",
          "rollback_probe"
        ]
      }
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
