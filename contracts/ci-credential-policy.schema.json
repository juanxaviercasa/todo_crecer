{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/ci-credential-policy.schema.json",
  "title": "ci-credential-policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "provider",
    "secret_refs",
    "maximum_ttl_seconds",
    "allowed_branch",
    "environment",
    "permissions",
    "plaintext_forbidden",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "provider": {
      "const": "github-actions"
    },
    "secret_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "maximum_ttl_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "allowed_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "environment": {
      "const": "staging"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "plaintext_forbidden": {
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
