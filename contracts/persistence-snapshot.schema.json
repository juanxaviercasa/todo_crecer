{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/persistence-snapshot.schema.json","title":"PersistenceSnapshot","type":"object","additionalProperties":false,"required":["schema_version","snapshot_id","tenant_id","entity_count","outbox_count","transaction_count","highwater_transaction_ref","content_digest","bytes","path","created_at"],"properties":{"schema_version":{"const":"0.1.0"},"snapshot_id":{"type":"string","pattern":"^psnap-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"entity_count":{"type":"integer","minimum":0},"outbox_count":{"type":"integer","minimum":0},"transaction_count":{"type":"integer","minimum":0},"highwater_transaction_ref":{"type":["string","null"],"pattern":"^cptx-[a-f0-9]{24}$"},"content_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":1},"path":{"type":"string","pattern":"^[a-zA-Z0-9._/-]{3,500}$"},"created_at":{"type":"string","format":"date-time"}}}
