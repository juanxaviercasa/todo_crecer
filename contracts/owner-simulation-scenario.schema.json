{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-simulation-scenario.schema.json",
  "title": "owner-simulation-scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "owner_ref",
    "name",
    "steps",
    "expected_outcome",
    "scenario_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "owner_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_outcome": {
      "enum": [
        "accepted",
        "timed_out",
        "needs_human",
        "changes_requested",
        "declined"
      ]
    },
    "scenario_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
