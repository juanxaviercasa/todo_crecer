{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/secure-asset-folder-plan.schema.json",
  "title": "secure-asset-folder-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "folder_id",
    "selection_ref",
    "folders",
    "rights_required",
    "upload_link_issued",
    "retention_days",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "folder_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "selection_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "folders": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rights_required": {
      "const": true
    },
    "upload_link_issued": {
      "const": false
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
