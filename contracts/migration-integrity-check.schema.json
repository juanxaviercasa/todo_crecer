{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/migration-integrity-check.schema.json",
  "title": "migration-integrity-check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "manifest_ref",
    "source_digest",
    "target_digest",
    "objects_checked",
    "objects_passed",
    "mismatches",
    "status",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "manifest_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "objects_checked": {
      "type": "integer",
      "minimum": 1
    },
    "objects_passed": {
      "type": "integer",
      "minimum": 0
    },
    "mismatches": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
