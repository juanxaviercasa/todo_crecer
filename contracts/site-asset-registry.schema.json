{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/site-asset-registry.schema.json",
  "title": "SiteAssetRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "environment", "assets", "generated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"type": "string", "pattern": "^registry-[a-f0-9]{16}$"},
    "environment": {"enum": ["local_demo", "private", "production"]},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "filename", "kind", "detected_type", "bytes", "content_sha256", "dimensions", "state", "eligibility", "rights"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"},
        "filename": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "kind": {"enum": ["logo", "photo", "video", "document"]},
        "detected_type": {"enum": ["image/png", "image/jpeg", "image/webp", "application/pdf", "video/mp4"]},
        "bytes": {"type": "integer", "minimum": 1},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "dimensions": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}]},
        "state": {"enum": ["synthetic_fixture", "web_ready", "revoked"]},
        "eligibility": {"type": "object", "additionalProperties": false, "required": ["local_demo", "private", "production"], "properties": {"local_demo": {"type": "boolean"}, "private": {"type": "boolean"}, "production": {"type": "boolean"}}},
        "rights": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"enum": ["approved_internal_fixture", "approved_owner", "revoked"]}, "evidence": {"type": "string", "minLength": 10, "maxLength": 300}}}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "synthetic_fixture"}}}, "then": {"properties": {"eligibility": {"properties": {"local_demo": {"const": true}, "private": {"const": false}, "production": {"const": false}}}, "rights": {"properties": {"status": {"const": "approved_internal_fixture"}}}}}},
        {"if": {"properties": {"state": {"const": "revoked"}}}, "then": {"properties": {"eligibility": {"properties": {"local_demo": {"const": false}, "private": {"const": false}, "production": {"const": false}}}, "rights": {"properties": {"status": {"const": "revoked"}}}}}}
      ]
    }
  }
}
