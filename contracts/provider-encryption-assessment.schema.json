{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-encryption-assessment.schema.json",
  "title": "provider-encryption-assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "candidate_ref",
    "at_rest",
    "in_transit",
    "customer_managed_key",
    "key_separation",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "at_rest": {
      "type": "boolean"
    },
    "in_transit": {
      "type": "boolean"
    },
    "customer_managed_key": {
      "type": "boolean"
    },
    "key_separation": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
