{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-simulation-run.schema.json",
  "title": "owner-simulation-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_ref",
    "case_ref",
    "status",
    "timeline",
    "sandbox_messages",
    "external_messages",
    "publications",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "scenario_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "status": {
      "enum": [
        "accepted",
        "timed_out",
        "needs_human",
        "changes_requested",
        "declined",
        "failed"
      ]
    },
    "timeline": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at_hour",
          "event"
        ],
        "properties": {
          "at_hour": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sandbox_messages": {
      "type": "integer",
      "minimum": 0
    },
    "external_messages": {
      "const": 0
    },
    "publications": {
      "const": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
