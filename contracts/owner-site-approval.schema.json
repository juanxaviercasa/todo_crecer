{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-site-approval.schema.json",
  "title": "owner-site-approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "room_ref",
    "package_ref",
    "review_round_ref",
    "acknowledgements",
    "identity_mode",
    "synthetic",
    "status",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "room_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "package_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "review_round_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "acknowledgements": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identity_mode": {
      "enum": [
        "synthetic",
        "verified_real"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "simulation_accepted",
        "owner_accepted"
      ]
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
