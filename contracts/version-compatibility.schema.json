{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/version-compatibility.schema.json","title":"VersionCompatibility","type":"object","additionalProperties":false,"required":["schema_version","evaluation_id","tenant_id","recipe_version_ref","design_version_ref","engine_version","verdict","reasons","evaluated_at"],"properties":{"schema_version":{"const":"0.1.0"},"evaluation_id":{"type":"string","pattern":"^compat-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"recipe_version_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"design_version_ref":{"type":"string","pattern":"^dsv-[a-f0-9]{24}$"},"engine_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"verdict":{"enum":["compatible","incompatible"]},"reasons":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":240}},"evaluated_at":{"type":"string","format":"date-time"}}}
