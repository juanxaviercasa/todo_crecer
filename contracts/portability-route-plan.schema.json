{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/portability-route-plan.schema.json",
  "title": "portability-route-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "source_adapter",
    "target_adapter",
    "steps",
    "writes_executed",
    "rollback_steps",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "route_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "source_adapter": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "target_adapter": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "steps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writes_executed": {
      "const": false
    },
    "rollback_steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "dry_run",
        "applied_simulation",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
