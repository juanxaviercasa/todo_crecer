{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/design-system-version.schema.json","title":"DesignSystemVersion","type":"object","additionalProperties":false,"required":["schema_version","design_version_id","tenant_id","design_system_id","version","status","token_digest","component_digest","accessibility_baseline","created_by","approved_by","created_at","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"design_version_id":{"type":"string","pattern":"^dsv-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"design_system_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-_]{1,80}$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"status":{"enum":["draft","active","deprecated","retired"]},"token_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"component_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"accessibility_baseline":{"type":"integer","minimum":0,"maximum":100},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"approved_by":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
