{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/simulated-owner-decision.schema.json",
  "title": "simulated-owner-decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "case_ref",
    "scenario_ref",
    "decision",
    "synthetic",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "scenario_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "decision": {
      "enum": [
        "interested",
        "questions",
        "declined",
        "silent"
      ]
    },
    "synthetic": {
      "const": true
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
