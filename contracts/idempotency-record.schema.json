{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/idempotency-record.schema.json","title":"IdempotencyRecord","type":"object","additionalProperties":false,"required":["schema_version","tenant_id","idempotency_key","request_digest","job_ref","status","created_at","expires_at"],"properties":{"schema_version":{"const":"0.1.0"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"idempotency_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9:._-]{7,159}$"},"request_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"job_ref":{"type":"string","pattern":"^job-[a-f0-9]{24}$"},"status":{"enum":["accepted","completed","expired"]},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"}}}
