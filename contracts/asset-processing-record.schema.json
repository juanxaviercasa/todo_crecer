{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/asset-processing-record.schema.json",
  "title": "AssetProcessingRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "tenant_id", "kind", "filename", "declared_type", "detected_type", "bytes", "content_sha256", "dimensions", "inspection", "scan", "rights", "variants", "state", "publishable", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "kind": {"enum": ["logo", "photo", "video", "document"]},
    "filename": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^/\\\\]+$"},
    "declared_type": {"enum": ["image/png", "image/jpeg", "image/webp", "application/pdf", "video/mp4"]},
    "detected_type": {"enum": ["image/png", "image/jpeg", "image/webp", "application/pdf", "video/mp4"]},
    "bytes": {"type": "integer", "minimum": 1, "maximum": 26214400},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dimensions": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1, "maximum": 12000}, "height": {"type": "integer", "minimum": 1, "maximum": 12000}}}
      ]
    },
    "inspection": {"type": "object", "additionalProperties": false, "required": ["signature_valid", "active_content_detected"], "properties": {"signature_valid": {"const": true}, "active_content_detected": {"const": false}}},
    "scan": {"type": "object", "additionalProperties": false, "required": ["status", "provider", "checked_at"], "properties": {"status": {"enum": ["pending", "clean", "malicious", "failed"]}, "provider": {"type": ["string", "null"], "maxLength": 100}, "checked_at": {"type": ["string", "null"], "format": "date-time"}}},
    "rights": {"type": "object", "additionalProperties": false, "required": ["status", "permission_note"], "properties": {"status": {"enum": ["pending_review", "approved", "rejected"]}, "permission_note": {"type": ["string", "null"], "maxLength": 1000}}},
    "variants": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/variant"}},
    "state": {"enum": ["quarantined", "awaiting_rights", "awaiting_variants", "ready_private", "web_ready", "rejected", "revoked"]},
    "publishable": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revocation": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["reason", "revoked_at"], "properties": {"reason": {"type": "string", "minLength": 5, "maxLength": 500}, "revoked_at": {"type": "string", "format": "date-time"}}}]}
  },
  "$defs": {
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "media_type", "bytes", "content_sha256", "object_key"],
      "properties": {
        "width": {"type": "integer", "enum": [160, 320, 480, 960, 1600]},
        "media_type": {"enum": ["image/webp", "image/jpeg", "image/png"]},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "object_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_\\.-]{2,240}$"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "web_ready"}}}, "then": {"properties": {"publishable": {"const": true}, "scan": {"properties": {"status": {"const": "clean"}}}, "rights": {"properties": {"status": {"const": "approved"}}}, "variants": {"minItems": 2}}}},
    {"if": {"properties": {"state": {"enum": ["quarantined", "awaiting_rights", "awaiting_variants", "ready_private", "rejected", "revoked"]}}}, "then": {"properties": {"publishable": {"const": false}}}}
  ]
}
