{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/fleet-rollback-record.schema.json","title":"FleetRollbackRecord","type":"object","additionalProperties":false,"required":["schema_version","rollback_id","tenant_id","cohort_ref","site_ids","from_recipe_ref","to_recipe_ref","trigger_type","trigger_ref","status","external_changes","planned_by","executed_by","planned_at","executed_at"],"properties":{"schema_version":{"const":"0.1.0"},"rollback_id":{"type":"string","pattern":"^frb-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"cohort_ref":{"type":"string","pattern":"^cohort-[a-f0-9]{24}$"},"site_ids":{"type":"array","minItems":1,"maxItems":10000,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"}},"from_recipe_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"to_recipe_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"trigger_type":{"enum":["checkpoint","drift","manual"]},"trigger_ref":{"type":"string","minLength":3,"maxLength":160},"status":{"enum":["planned","executed","failed"]},"external_changes":{"const":false},"planned_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"executed_by":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"planned_at":{"type":"string","format":"date-time"},"executed_at":{"type":["string","null"],"format":"date-time"}}}
