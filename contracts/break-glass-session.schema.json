{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/break-glass-session.schema.json",
  "title": "break-glass-session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "requester_ref",
    "approver_ref",
    "ticket_ref",
    "reason",
    "capabilities",
    "tenant_scopes",
    "status",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "requester_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "approver_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ticket_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "reason": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tenant_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "pending",
        "active",
        "expired",
        "revoked",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
