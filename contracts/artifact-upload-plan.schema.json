{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/artifact-upload-plan.schema.json","title":"ArtifactUploadPlan","type":"object","additionalProperties":false,
  "required":["schema_version","upload_plan_id","tenant_id","build_id","bucket_binding","prefix","manifest_digest","artifacts","total_bytes","immutable","created_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"upload_plan_id":{"type":"string","pattern":"^uploadplan-[a-f0-9]{24}$"},"tenant_id":{"type":"string"},"build_id":{"type":"string"},"bucket_binding":{"const":"SITE_ARTIFACTS"},"prefix":{"type":"string","pattern":"^tenants/[a-z0-9-]+/builds/[a-z0-9-]+/$"},"manifest_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"artifacts":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","bytes","cache_control"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":1},"cache_control":{"type":"string","minLength":3,"maxLength":100}}}},"total_bytes":{"type":"integer","minimum":1},"immutable":{"const":true},"created_at":{"type":"string","format":"date-time"}}
}
