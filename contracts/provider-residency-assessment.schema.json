{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-residency-assessment.schema.json",
  "title": "provider-residency-assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "candidate_ref",
    "required_region",
    "observed_region",
    "region_match",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "required_region": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "observed_region": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "region_match": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
