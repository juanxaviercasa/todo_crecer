{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/canary-observation.schema.json","title":"CanaryObservation","type":"object","additionalProperties":false,
  "required":["schema_version","observation_id","run_id","plan_id","tenant_id","stage_percent","release_ref","sample_size","availability_percent","latency_p95_ms","error_count","status","slo_policy_refs","observed_by","observed_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"observation_id":{"type":"string","pattern":"^goliveo-[a-f0-9]{24}$"},"run_id":{"type":"string","pattern":"^goliver-[a-f0-9]{24}$"},"plan_id":{"type":"string","pattern":"^golivep-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"stage_percent":{"enum":[5,25,50,100]},"release_ref":{"type":"string","minLength":3,"maxLength":160},"sample_size":{"type":"integer","minimum":1},"availability_percent":{"type":"number","minimum":0,"maximum":100},"latency_p95_ms":{"type":"integer","minimum":0},"error_count":{"type":"integer","minimum":0},"status":{"enum":["passed","failed"]},"slo_policy_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":160}},"observed_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"observed_at":{"type":"string","format":"date-time"}}
}
