{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/evidence-redaction-record.schema.json",
  "title": "evidence-redaction-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "redaction_id",
    "evidence_ref",
    "removed_fields",
    "retained_fields",
    "redacted_digest",
    "status",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "redaction_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "removed_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retained_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "redacted_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "redacted"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
