{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase45-final-authorization.schema.json",
  "title": "phase45-final-authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "freeze_ref": {
      "type": "string",
      "minLength": 1
    },
    "freeze_digest": {
      "type": "string",
      "minLength": 1
    },
    "approval_roles": {
      "type": "array",
      "prefixItems": [
        {
          "const": "security_approver"
        },
        {
          "const": "platform_approver"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "approver_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "token_hash": {
      "type": "string",
      "minLength": 1
    },
    "ttl_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "single_use": {
      "type": "boolean",
      "const": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "consumed",
        "revoked",
        "expired"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "authorization_id",
    "freeze_ref",
    "freeze_digest",
    "approval_roles",
    "approver_ids",
    "token_hash",
    "ttl_minutes",
    "single_use",
    "status",
    "created_at"
  ]
}
