{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-contract-run.schema.json",
  "title": "provider-contract-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "adapter_ref",
    "result_refs",
    "passed",
    "failed",
    "mandatory_pass",
    "write_operations",
    "status",
    "executed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "adapter_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "result_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "mandatory_pass": {
      "type": "boolean"
    },
    "write_operations": {
      "const": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
