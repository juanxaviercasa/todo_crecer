{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/staging-apply-receipt.schema.json",
  "title": "staging-apply-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "plan_ref",
    "action_order",
    "method",
    "endpoint_template",
    "request_digest",
    "response_digest",
    "http_status",
    "external_change",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "action_order": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "enum": [
        "POST",
        "PUT",
        "PATCH"
      ]
    },
    "endpoint_template": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "external_change": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
