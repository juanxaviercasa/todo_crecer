{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/incident-record.schema.json","title":"IncidentRecord","type":"object","additionalProperties":false,
  "required":["schema_version","incident_id","tenant_id","severity","status","title","alert_refs","release_refs","commander_id","timeline","opened_at","resolved_at"],
