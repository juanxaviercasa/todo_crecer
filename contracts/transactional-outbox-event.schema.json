{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/transactional-outbox-event.schema.json","title":"TransactionalOutboxEvent","type":"object","additionalProperties":false,"required":["schema_version","event_id","tenant_id","aggregate_type","aggregate_id","aggregate_version","event_type","payload_digest","transaction_ref","status","attempts","lease_owner","lease_until","created_at","delivered_at"],"properties":{"schema_version":{"const":"0.1.0"},"event_id":{"type":"string","pattern":"^outbox-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"aggregate_type":{"enum":["desired_state","observed_state","job","lease","budget","idempotency","dead_letter","fleet_site"]},"aggregate_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9:._-]{2,159}$"},"aggregate_version":{"type":"integer","minimum":1},"event_type":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{4,119}$"},"payload_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"transaction_ref":{"type":"string","pattern":"^cptx-[a-f0-9]{24}$"},"status":{"enum":["pending","claimed","delivered","dead_lettered"]},"attempts":{"type":"integer","minimum":0,"maximum":100},"lease_owner":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"lease_until":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"},"delivered_at":{"type":["string","null"],"format":"date-time"}}}
