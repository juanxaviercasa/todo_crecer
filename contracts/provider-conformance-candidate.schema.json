{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-conformance-candidate.schema.json",
  "title": "provider-conformance-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "label",
    "storage_provider",
    "kms_provider",
    "regions",
    "declared_capabilities",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "storage_provider": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "kms_provider": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "declared_capabilities": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "status": {
      "const": "registered"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
