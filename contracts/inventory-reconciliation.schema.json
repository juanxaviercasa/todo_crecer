{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/inventory-reconciliation.schema.json",
  "title": "inventory-reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reconciliation_id",
    "intent_ref",
    "discovery_ref",
    "actions",
    "orphaned_resources",
    "status",
    "reconciliation_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "reconciliation_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_ref": {
      "type": "string",
      "minLength": 1
    },
    "discovery_ref": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "kind",
          "logical_name",
          "action",
          "desired_digest"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "logical_name": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "verify",
              "create",
              "update"
            ]
          },
          "desired_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "orphaned_resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "in_sync",
        "changes_required",
        "blocked"
      ]
    },
    "reconciliation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
