{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/production-vault-adapter.schema.json",
  "title": "production-vault-adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "kind",
    "provider",
    "endpoint_template",
    "capabilities",
    "external_connections",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "kind": {
      "enum": [
        "object_storage",
        "kms"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_template": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_connections": {
      "const": false
    },
    "status": {
      "const": "simulated"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
