{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/security-audit-entry.schema.json",
  "title": "security-audit-entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "entry_id",
    "actor_ref",
    "action",
    "subject_ref",
    "decision",
    "details_digest",
    "previous_hash",
    "entry_hash",
    "key_ref",
    "signature",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "actor_ref": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,119}$"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 2,
      "maxLength": 240
    },
    "decision": {
      "enum": [
        "success",
        "denied",
        "failure"
      ]
    },
    "details_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "signature": {
      "type": "string",
      "minLength": 40,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
