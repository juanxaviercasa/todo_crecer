{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/key-rewrap-plan.schema.json",
  "title": "key-rewrap-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "source_key_adapter",
    "target_key_adapter",
    "object_count",
    "plaintext_exposed",
    "rewrapped_count",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "source_key_adapter": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "target_key_adapter": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "object_count": {
      "type": "integer",
      "minimum": 1
    },
    "plaintext_exposed": {
      "const": false
    },
    "rewrapped_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "validated",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
