{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/conversation-script.schema.json",
  "title": "conversation-script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "script_id",
    "selection_ref",
    "opening",
    "value_explanation",
    "consent_explanation",
    "questions",
    "decline_response",
    "claims_mode",
    "script_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "script_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "selection_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "opening": {
      "type": "string",
      "minLength": 60
    },
    "value_explanation": {
      "type": "string",
      "minLength": 1
    },
    "consent_explanation": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decline_response": {
      "type": "string",
      "minLength": 1
    },
    "claims_mode": {
      "const": "invitation_only"
    },
    "script_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
