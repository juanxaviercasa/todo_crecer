{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-capability-probe.schema.json",
  "title": "provider-capability-probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "session_ref",
    "candidate_ref",
    "capability",
    "observed",
    "evidence_digest",
    "read_operations",
    "write_operations",
    "status",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "probe_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "session_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "observed": {
      "type": "boolean"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "read_operations": {
      "type": "integer",
      "minimum": 1
    },
    "write_operations": {
      "const": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
