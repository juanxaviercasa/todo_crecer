{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/control-plane-transaction.schema.json","title":"ControlPlaneTransaction","type":"object","additionalProperties":false,"required":["schema_version","transaction_id","tenant_id","status","write_count","outbox_count","actor_id","committed_at"],"properties":{"schema_version":{"const":"0.1.0"},"transaction_id":{"type":"string","pattern":"^cptx-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"status":{"const":"committed"},"write_count":{"type":"integer","minimum":1,"maximum":10000},"outbox_count":{"type":"integer","minimum":1,"maximum":10000},"actor_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"committed_at":{"type":"string","format":"date-time"}}}
