{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-object.schema.json",
  "title": "vault-object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "vault_ref",
    "case_ref",
    "kind",
    "ciphertext_digest",
    "key_ref",
    "size_bytes",
    "synthetic",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "vault_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "kind": {
      "enum": [
        "evidence",
        "asset",
        "dossier",
        "acceptance"
      ]
    },
    "ciphertext_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "active",
        "lost",
        "destroyed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
