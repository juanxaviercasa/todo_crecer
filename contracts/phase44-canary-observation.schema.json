{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase44-canary-observation.schema.json",
  "title": "phase44-canary-observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "stage_percent": {
      "type": "integer",
      "enum": [
        5,
        25,
        50,
        100
      ]
    },
    "availability": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "latency_p95_ms": {
      "type": "integer",
      "minimum": 0
    },
    "error_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "integrity_mismatches": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "boolean"
    },
    "external_changes": {
      "type": "boolean",
      "const": false
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "plan_ref",
    "stage_percent",
    "availability",
    "latency_p95_ms",
    "error_rate",
    "integrity_mismatches",
    "passed",
    "external_changes",
    "observed_at"
  ]
}
