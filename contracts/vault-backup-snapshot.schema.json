{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-backup-snapshot.schema.json",
  "title": "vault-backup-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "vault_ref",
    "objects",
    "encrypted",
    "status",
    "snapshot_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "vault_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_ref",
          "ciphertext_digest"
        ],
        "properties": {
          "object_ref": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "ciphertext_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "encrypted": {
      "const": true
    },
    "status": {
      "enum": [
        "sealed",
        "restored"
      ]
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
