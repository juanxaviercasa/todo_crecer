{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/staging-budget.schema.json",
  "title": "staging-budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "budget_id",
    "environment_ref",
    "monthly_limit_cents",
    "warning_percent",
    "hard_stop_percent",
    "status",
    "approved_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "budget_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "monthly_limit_cents": {
      "type": "integer",
      "minimum": 1
    },
    "warning_percent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "hard_stop_percent": {
      "type": "integer",
      "minimum": 100,
      "maximum": 100
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "exhausted",
        "closed"
      ]
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
