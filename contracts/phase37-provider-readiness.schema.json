{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase37-provider-readiness.schema.json",
  "title": "phase37-provider-readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "checks",
    "blockers",
    "status",
    "write_status",
    "external_connections",
    "publications",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "readiness_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "status": {
      "enum": [
        "ready_for_read_only_preflight",
        "incomplete"
      ]
    },
    "write_status": {
      "const": "blocked"
    },
    "external_connections": {
      "const": false
    },
    "publications": {
      "const": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
