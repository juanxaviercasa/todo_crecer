{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase46-credential-rotation.schema.json",
  "title": "phase46-credential-rotation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "rotation_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "previous_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "new_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "key_material_persisted": {
      "type": "boolean",
      "const": false
    },
    "grace_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "old_revoked": {
      "type": "boolean"
    },
    "external_changes": {
      "type": "boolean",
      "const": false
    },
    "status": {
      "type": "string",
      "const": "simulated_verified"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "rotation_id",
    "provider_fingerprint",
    "previous_fingerprint",
    "new_fingerprint",
    "key_material_persisted",
    "grace_minutes",
    "old_revoked",
    "external_changes",
    "status",
    "created_at"
  ]
}
