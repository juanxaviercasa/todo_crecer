{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/evidence-classification.schema.json",
  "title": "evidence-classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification_id",
    "evidence_ref",
    "sensitivity",
    "data_categories",
    "retention_days",
    "classified_by",
    "classified_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "classification_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "sensitivity": {
      "enum": [
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "business_truth",
          "contact",
          "asset_rights",
          "acceptance"
        ]
      }
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "classified_by": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "classified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
