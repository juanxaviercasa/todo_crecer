{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/outreach-message-draft.schema.json",
  "title": "outreach-message-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "case_ref",
    "channel",
    "subject",
    "body",
    "claims_mode",
    "delivery_status",
    "external_message",
    "draft_digest",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "channel": {
      "enum": [
        "whatsapp",
        "email",
        "manual"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 80,
      "maxLength": 1200
    },
    "claims_mode": {
      "const": "invitation_only"
    },
    "delivery_status": {
      "const": "draft"
    },
    "external_message": {
      "const": false
    },
    "draft_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
