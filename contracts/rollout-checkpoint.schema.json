{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/rollout-checkpoint.schema.json","title":"RolloutCheckpoint","type":"object","additionalProperties":false,"required":["schema_version","checkpoint_id","tenant_id","cohort_ref","step_percent","observed_sites","average_quality_score","incident_count","critical_drift_count","verdict","reason","evaluated_by","evaluated_at"],"properties":{"schema_version":{"const":"0.1.0"},"checkpoint_id":{"type":"string","pattern":"^rcp-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"cohort_ref":{"type":"string","pattern":"^cohort-[a-f0-9]{24}$"},"step_percent":{"type":"integer","minimum":1,"maximum":100},"observed_sites":{"type":"integer","minimum":1,"maximum":10000},"average_quality_score":{"type":"integer","minimum":0,"maximum":100},"incident_count":{"type":"integer","minimum":0},"critical_drift_count":{"type":"integer","minimum":0},"verdict":{"enum":["pass","hold","rollback"]},"reason":{"type":"string","minLength":10,"maxLength":500},"evaluated_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"evaluated_at":{"type":"string","format":"date-time"}}}
