{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/fleet-site-record.schema.json","title":"FleetSiteRecord","type":"object","additionalProperties":false,"required":["schema_version","tenant_id","site_id","archetype","cohort_label","current_recipe_ref","current_design_ref","engine_version","target_recipe_ref","target_design_ref","status","release_digest","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"archetype":{"enum":["catalog","developer","advisor","projects","valuation"]},"cohort_label":{"type":"string","minLength":2,"maxLength":80},"current_recipe_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"current_design_ref":{"type":"string","pattern":"^dsv-[a-f0-9]{24}$"},"engine_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"target_recipe_ref":{"type":["string","null"],"pattern":"^rv-[a-f0-9]{24}$"},"target_design_ref":{"type":["string","null"],"pattern":"^dsv-[a-f0-9]{24}$"},"status":{"enum":["stable","scheduled","canary","paused","rolled_back"]},"release_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"updated_at":{"type":"string","format":"date-time"}}}
