{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/queue-snapshot.schema.json","title":"QueueSnapshot","type":"object","additionalProperties":false,"required":["schema_version","snapshot_id","tenant_id","job_counts","active_leases","scheduled_retries","open_dead_letters","budget_ref","budget_remaining_jobs","budget_remaining_cost_units","generated_at"],"properties":{"schema_version":{"const":"0.1.0"},"snapshot_id":{"type":"string","pattern":"^queue-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"job_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"active_leases":{"type":"integer","minimum":0},"scheduled_retries":{"type":"integer","minimum":0},"open_dead_letters":{"type":"integer","minimum":0},"budget_ref":{"type":"string","pattern":"^budget-[a-f0-9]{24}$"},"budget_remaining_jobs":{"type":"integer","minimum":0},"budget_remaining_cost_units":{"type":"integer","minimum":0},"generated_at":{"type":"string","format":"date-time"}}}
