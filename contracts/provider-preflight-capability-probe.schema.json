{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-preflight-capability-probe.schema.json",
  "title": "provider-preflight-capability-probe",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "probe_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "reads": {
      "type": "integer",
      "minimum": 0
    },
    "writes": {
      "type": "integer",
      "const": 0
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "probed_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "probe_id",
    "candidate_id",
    "reads",
    "writes",
    "capabilities",
    "evidence_digest",
    "status",
    "probed_at"
  ]
}
