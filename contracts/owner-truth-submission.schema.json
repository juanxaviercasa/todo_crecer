{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-truth-submission.schema.json",
  "title": "owner-truth-submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "case_ref",
    "business_name",
    "services",
    "service_areas",
    "contact_permission",
    "truth_digest",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "business_name": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "service_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contact_permission": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "truth_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
