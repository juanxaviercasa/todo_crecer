{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/candidate-risk-matrix.schema.json",
  "title": "candidate-risk-matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "candidate_ref",
    "risks",
    "critical_open",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "matrix_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "risks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "risk",
          "severity",
          "mitigation",
          "open"
        ],
        "properties": {
          "domain": {
            "enum": [
              "legal",
              "security",
              "finance",
              "procurement"
            ]
          },
          "risk": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "open": {
            "type": "boolean"
          }
        }
      }
    },
    "critical_open": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "controlled",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
