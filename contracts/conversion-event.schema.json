{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/conversion-event.schema.json","title":"ConversionEvent","type":"object","additionalProperties":false,"required":["schema_version","event_id","tenant_id","site_id","archetype","type","session_bucket","route_group","device_class","consent_mode","experiment_ref","variant","occurred_at","retention_until"],"properties":{"schema_version":{"const":"0.1.0"},"event_id":{"type":"string","pattern":"^conve-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"archetype":{"enum":["catalog","developer","advisor","projects","valuation"]},"type":{"enum":["page_view","cta_view","cta_click","form_start","form_submit_accepted","lead_qualified","appointment_requested"]},"session_bucket":{"type":"string","pattern":"^sb-[a-f0-9]{16}$"},"route_group":{"enum":["home","service","catalog","project","contact"]},"device_class":{"enum":["mobile","tablet","desktop"]},"consent_mode":{"enum":["essential","analytics"]},"experiment_ref":{"type":["string","null"],"pattern":"^expt-[a-f0-9]{24}$"},"variant":{"type":["string","null"],"enum":[null,"control","treatment"]},"occurred_at":{"type":"string","format":"date-time"},"retention_until":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"experiment_ref":{"type":"string"}}},"then":{"properties":{"variant":{"type":"string"}}}},{"if":{"properties":{"experiment_ref":{"type":"null"}}},"then":{"properties":{"variant":{"type":"null"}}}}]}
