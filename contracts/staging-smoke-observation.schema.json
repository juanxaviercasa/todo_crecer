{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/staging-smoke-observation.schema.json",
  "title": "staging-smoke-observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "suite_ref",
    "check",
    "result",
    "evidence_digest",
    "external_changes",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "suite_ref": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "external_changes": {
      "type": "boolean"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
