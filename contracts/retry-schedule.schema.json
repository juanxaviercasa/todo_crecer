{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/retry-schedule.schema.json","title":"RetrySchedule","type":"object","additionalProperties":false,"required":["schema_version","retry_id","tenant_id","job_ref","attempt","delay_seconds","available_at","reason_code","created_at"],"properties":{"schema_version":{"const":"0.1.0"},"retry_id":{"type":"string","pattern":"^retry-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"job_ref":{"type":"string","pattern":"^job-[a-f0-9]{24}$"},"attempt":{"type":"integer","minimum":1,"maximum":100},"delay_seconds":{"type":"integer","minimum":1,"maximum":86400},"available_at":{"type":"string","format":"date-time"},"reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,79}$"},"created_at":{"type":"string","format":"date-time"}}}
