{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/infrastructure-readiness.schema.json",
  "title": "InfrastructureReadiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "environment", "status", "checks", "missing_configuration", "may_deploy", "may_publish", "generated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "profile_id": {"type": "string"},
    "environment": {"enum": ["local", "preview", "production"]},
    "status": {"enum": ["ready", "blocked"]},
    "checks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "provider", "status", "missing"],
        "properties": {
          "service": {"enum": ["identity", "database", "key_management", "object_storage", "queue", "malware_scan"]},
          "provider": {"enum": ["local", "cloudflare", "external"]},
          "status": {"enum": ["ready", "blocked"]},
          "missing": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "missing_configuration": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "may_deploy": {"type": "boolean"},
    "may_publish": {"const": false},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
