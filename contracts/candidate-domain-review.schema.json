{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/candidate-domain-review.schema.json",
  "title": "candidate-domain-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "candidate_ref",
    "domain",
    "evidence_mode",
    "findings",
    "decision",
    "reviewer_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "domain": {
      "enum": [
        "legal",
        "security",
        "finance",
        "procurement"
      ]
    },
    "evidence_mode": {
      "enum": [
        "placeholder",
        "mixed",
        "real"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": [
        "conditional",
        "approved",
        "blocked"
      ]
    },
    "reviewer_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
