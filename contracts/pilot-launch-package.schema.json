{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.hazlocrecer.com/pilot-launch-package.schema.json",
  "title":"PilotLaunchPackage",
  "type":"object","additionalProperties":false,
  "required":["schema_version","package_id","dossier_id","dossier_hash","tenant_id","business_id","readiness_ref","rehearsal_ref","artifact_refs","content_digest","status","may_publish","generated_by","generated_at"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "package_id":{"type":"string","pattern":"^pilotp-[a-f0-9]{24}$"},
    "dossier_id":{"type":"string","pattern":"^pilotd-[a-f0-9]{24}$"},
    "dossier_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "business_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "readiness_ref":{"type":"string","pattern":"^pilote-[a-f0-9]{24}$"},
    "rehearsal_ref":{"type":"string","pattern":"^piloth-[a-f0-9]{24}$"},
    "artifact_refs":{"type":"array","minItems":5,"maxItems":30,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":240}},
    "content_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "status":{"enum":["sealed_local","revoked"]},
    "may_publish":{"const":false},
    "generated_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "generated_at":{"type":"string","format":"date-time"}
  }
}
