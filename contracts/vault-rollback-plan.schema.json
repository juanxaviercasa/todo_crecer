{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-rollback-plan.schema.json",
  "title": "vault-rollback-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rollback_id",
    "plan_ref",
    "steps",
    "rehearsal_status",
    "external_changes",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "rollback_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rehearsal_status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "external_changes": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
