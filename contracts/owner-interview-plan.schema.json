{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-interview-plan.schema.json",
  "title": "owner-interview-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interview_id",
    "case_ref",
    "mode",
    "topics",
    "status",
    "external_calendar_event",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "interview_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "mode": {
      "enum": [
        "video",
        "phone",
        "in_person",
        "asynchronous"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "proposed",
        "scheduled",
        "completed",
        "cancelled"
      ]
    },
    "scheduled_for": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_calendar_event": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
