{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/restore-run.schema.json","title":"RestoreRun","type":"object","additionalProperties":false,"required":["schema_version","run_id","plan_ref","status","integrity_check","digest_match","entity_count_match","delivered_events_preserved","pending_events_recoverable","lost_transactions","measured_rpo_seconds","measured_rto_seconds","objective_met","external_changes","executed_by","started_at","finished_at"],"properties":{"schema_version":{"const":"0.1.0"},"run_id":{"type":"string","pattern":"^rrun-[a-f0-9]{24}$"},"plan_ref":{"type":"string","pattern":"^rplan-[a-f0-9]{24}$"},"status":{"enum":["passed","failed"]},"integrity_check":{"enum":["ok","failed"]},"digest_match":{"type":"boolean"},"entity_count_match":{"type":"boolean"},"delivered_events_preserved":{"type":"boolean"},"pending_events_recoverable":{"type":"boolean"},"lost_transactions":{"type":"integer","minimum":0},"measured_rpo_seconds":{"type":"integer","minimum":0},"measured_rto_seconds":{"type":"number","minimum":0},"objective_met":{"type":"boolean"},"external_changes":{"const":false},"executed_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"}}}
