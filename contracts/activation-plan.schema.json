{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.local/activation-plan.schema.json",
  "title": "activation-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "environment_ref",
    "discovery_ref",
    "desired_manifest_digest",
    "actions",
    "estimated_requests",
    "estimated_monthly_cost_cents",
    "plan_digest",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "discovery_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "desired_manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "kind",
          "logical_name",
          "action",
          "desired_digest",
          "provider_ref"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          },
          "logical_name": {
            "type": "string"
          },
          "action": {
            "enum": [
              "create",
              "update",
              "verify",
              "retain"
            ]
          },
          "desired_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "estimated_requests": {
      "type": "integer",
      "minimum": 1
    },
    "estimated_monthly_cost_cents": {
      "type": "integer",
      "minimum": 0
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "authorized",
        "applied",
        "blocked",
        "expired"
      ]
    },
    "created_by": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,159}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
