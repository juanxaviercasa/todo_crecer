{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/hypercare-check.schema.json","title":"HypercareCheck","type":"object","additionalProperties":false,
  "required":["schema_version","check_id","run_id","plan_id","tenant_id","window","availability_percent","latency_p95_ms","open_incidents","status","rollback_required","notes","checked_by","checked_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"check_id":{"type":"string","pattern":"^goliveh-[a-f0-9]{24}$"},"run_id":{"type":"string","pattern":"^goliver-[a-f0-9]{24}$"},"plan_id":{"type":"string","pattern":"^golivep-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"window":{"enum":["launch","24h","72h"]},"availability_percent":{"type":"number","minimum":0,"maximum":100},"latency_p95_ms":{"type":"integer","minimum":0},"open_incidents":{"type":"integer","minimum":0},"status":{"enum":["passed","failed"]},"rollback_required":{"type":"boolean"},"notes":{"type":["string","null"],"maxLength":1000},"checked_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"checked_at":{"type":"string","format":"date-time"}},
  "allOf":[{"if":{"properties":{"status":{"const":"passed"}}},"then":{"properties":{"open_incidents":{"const":0},"rollback_required":{"const":false}}}},{"if":{"properties":{"rollback_required":{"const":true}}},"then":{"properties":{"status":{"const":"failed"}}}}]
}
