{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-response-record.schema.json",
  "title": "owner-response-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "response_id",
    "case_ref",
    "consent_ref",
    "decision",
    "response_digest",
    "received_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "response_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "consent_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "decision": {
      "enum": [
        "interested",
        "declined",
        "questions"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "response_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
