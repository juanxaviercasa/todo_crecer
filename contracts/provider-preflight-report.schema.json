{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-preflight-report.schema.json",
  "title": "provider-preflight-report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "candidate_refs",
    "selected_candidate_ref",
    "scorecards",
    "sessions_closed",
    "real_read_only_executed",
    "write_operations",
    "status",
    "sealed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "selected_candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "scorecards": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "sessions_closed": {
      "const": true
    },
    "real_read_only_executed": {
      "const": false
    },
    "write_operations": {
      "const": 0
    },
    "status": {
      "const": "sealed_rehearsal"
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
