{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/simulated-owner-profile.schema.json",
  "title": "simulated-owner-profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_id",
    "case_ref",
    "persona",
    "synthetic",
    "response_pattern",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "persona": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "response_pattern": {
      "enum": [
        "fast_accept",
        "no_response",
        "questions",
        "incomplete_assets",
        "decline"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
