{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/operation-budget.schema.json","title":"OperationBudget","type":"object","additionalProperties":false,"required":["schema_version","budget_id","tenant_id","period_start","period_end","max_jobs","max_cost_units","consumed_jobs","consumed_cost_units","status","created_by","created_at","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"budget_id":{"type":"string","pattern":"^budget-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"period_start":{"type":"string","format":"date-time"},"period_end":{"type":"string","format":"date-time"},"max_jobs":{"type":"integer","minimum":1,"maximum":10000000},"max_cost_units":{"type":"integer","minimum":1,"maximum":1000000000},"consumed_jobs":{"type":"integer","minimum":0},"consumed_cost_units":{"type":"integer","minimum":0},"status":{"enum":["open","exhausted","closed"]},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
