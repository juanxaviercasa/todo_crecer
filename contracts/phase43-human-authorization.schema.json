{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase43-human-authorization.schema.json",
  "title": "phase43-human-authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "manifest_digest": {
      "type": "string",
      "minLength": 1
    },
    "legal_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "procurement_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reversible": {
      "type": "boolean",
      "const": true
    },
    "nonce_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "blocked",
        "authorized"
      ]
    },
    "authorized_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "authorization_id",
    "manifest_ref",
    "manifest_digest",
    "legal_ref",
    "procurement_ref",
    "verification_ref",
    "reversible",
    "nonce_hash",
    "status",
    "authorized_at"
  ]
}
