{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/rollout-cohort.schema.json","title":"RolloutCohort","type":"object","additionalProperties":false,"required":["schema_version","cohort_id","tenant_id","name","site_ids","target_recipe_ref","target_design_ref","steps_percent","quality_threshold","rollback_threshold","max_incidents","status","current_step","created_by","approved_by","created_at","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"cohort_id":{"type":"string","pattern":"^cohort-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"name":{"type":"string","minLength":3,"maxLength":120},"site_ids":{"type":"array","minItems":1,"maxItems":10000,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"}},"target_recipe_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"target_design_ref":{"type":"string","pattern":"^dsv-[a-f0-9]{24}$"},"steps_percent":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":100},"contains":{"const":100}},"quality_threshold":{"type":"integer","minimum":0,"maximum":100},"rollback_threshold":{"type":"integer","minimum":0,"maximum":100},"max_incidents":{"type":"integer","minimum":0,"maximum":1000},"status":{"enum":["draft","approved","running","paused","completed","rolled_back"]},"current_step":{"type":"integer","minimum":0,"maximum":100},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"approved_by":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
