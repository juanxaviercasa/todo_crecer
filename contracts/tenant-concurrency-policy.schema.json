{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/tenant-concurrency-policy.schema.json","title":"TenantConcurrencyPolicy","type":"object","additionalProperties":false,"required":["schema_version","tenant_id","max_global","max_per_operation","max_per_site","lease_seconds","updated_by","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"max_global":{"type":"integer","minimum":1,"maximum":10000},"max_per_operation":{"type":"integer","minimum":1,"maximum":10000},"max_per_site":{"type":"integer","minimum":1,"maximum":100},"lease_seconds":{"type":"integer","minimum":10,"maximum":86400},"updated_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"updated_at":{"type":"string","format":"date-time"}}}
