{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/backup-artifact.schema.json","title":"BackupArtifact","type":"object","additionalProperties":false,"required":["schema_version","backup_id","database_digest","bytes","entity_count","outbox_count","transaction_count","highwater_transaction_ref","path","status","created_by","created_at"],"properties":{"schema_version":{"const":"0.1.0"},"backup_id":{"type":"string","pattern":"^backup-[a-f0-9]{24}$"},"database_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":1},"entity_count":{"type":"integer","minimum":0},"outbox_count":{"type":"integer","minimum":0},"transaction_count":{"type":"integer","minimum":0},"highwater_transaction_ref":{"type":["string","null"],"pattern":"^cptx-[a-f0-9]{24}$"},"path":{"type":"string","pattern":"^[a-zA-Z0-9._/-]{3,500}$"},"status":{"const":"verified"},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"}}}
