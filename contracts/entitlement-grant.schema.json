{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/entitlement-grant.schema.json","title":"EntitlementGrant","type":"object","additionalProperties":false,
  "required":["schema_version","grant_id","tenant_id","capability","source","status","limit","starts_at","expires_at","reason","granted_by","created_at"],
  "properties":{"schema_version":{"const":"0.1.0"},"grant_id":{"type":"string","pattern":"^grant-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"capability":{"enum":["portal.access","privacy.request","data.export.request","site.preview","site.publish","lead.capture","custom.domain","analytics.basic","content.change.request","asset.upload","multi.site"]},"source":{"enum":["manual_pilot","support_override"]},"status":{"enum":["active","revoked"]},"limit":{"type":["integer","null"],"minimum":1},"starts_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"reason":{"type":"string","minLength":5,"maxLength":500},"granted_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"type":"string","format":"date-time"}}
}
