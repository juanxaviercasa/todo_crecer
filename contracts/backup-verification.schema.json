{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/backup-verification.schema.json","title":"BackupVerification","type":"object","additionalProperties":false,"required":["schema_version","verification_id","backup_ref","digest_match","integrity_check","entity_count_match","outbox_count_match","transaction_count_match","status","verified_at"],"properties":{"schema_version":{"const":"0.1.0"},"verification_id":{"type":"string","pattern":"^bverify-[a-f0-9]{24}$"},"backup_ref":{"type":"string","pattern":"^backup-[a-f0-9]{24}$"},"digest_match":{"type":"boolean"},"integrity_check":{"enum":["ok","failed"]},"entity_count_match":{"type":"boolean"},"outbox_count_match":{"type":"boolean"},"transaction_count_match":{"type":"boolean"},"status":{"enum":["passed","failed"]},"verified_at":{"type":"string","format":"date-time"}}}
