{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/go-live-audit-event.schema.json","title":"GoLiveAuditEvent","type":"object","additionalProperties":false,
  "required":["schema_version","event_id","tenant_id","plan_id","type","subject_ref","actor_id","occurred_at","previous_hash","event_hash"],
  "properties":{"schema_version":{"const":"0.1.0"},"event_id":{"type":"string","pattern":"^goliveev-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"plan_id":{"type":"string","pattern":"^golivep-[a-f0-9]{24}$"},"type":{"enum":["plan.created","plan.updated","freeze.activated","decision.recorded","run.started","canary.observed","rollback.triggered","hypercare.checked","run.closed"]},"subject_ref":{"type":"string","minLength":3,"maxLength":160},"actor_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"occurred_at":{"type":"string","format":"date-time"},"previous_hash":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"event_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
