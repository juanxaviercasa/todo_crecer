{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/experiment-observation.schema.json","title":"ExperimentObservation","type":"object","additionalProperties":false,"required":["schema_version","observation_id","experiment_id","definition_digest","tenant_id","variant","exposures","conversions","conversion_percent","web_vitals_p75","incidents","period_start","period_end","recorded_at"],"properties":{"schema_version":{"const":"0.1.0"},"observation_id":{"type":"string","pattern":"^expto-[a-f0-9]{24}$"},"experiment_id":{"type":"string","pattern":"^expt-[a-f0-9]{24}$"},"definition_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"variant":{"enum":["control","treatment"]},"exposures":{"type":"integer","minimum":1},"conversions":{"type":"integer","minimum":0},"conversion_percent":{"type":"number","minimum":0,"maximum":100},"web_vitals_p75":{"type":"object","additionalProperties":false,"required":["lcp_ms","inp_ms","cls"],"properties":{"lcp_ms":{"type":"integer","minimum":0},"inp_ms":{"type":"integer","minimum":0},"cls":{"type":"number","minimum":0}}},"incidents":{"type":"integer","minimum":0},"period_start":{"type":"string","format":"date-time"},"period_end":{"type":"string","format":"date-time"},"recorded_at":{"type":"string","format":"date-time"}}}
