{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/provider-discovery-session.schema.json",
  "title": "provider-discovery-session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "candidate_ref",
    "credential_fingerprint",
    "scopes",
    "expires_at",
    "secret_material_present",
    "write_allowed",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "credential_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "metadata.read"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "secret_material_present": {
      "const": false
    },
    "write_allowed": {
      "const": false
    },
    "status": {
      "enum": [
        "active",
        "closed",
        "expired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
