{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/assisted-pilot-rehearsal.schema.json",
  "title": "assisted-pilot-rehearsal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rehearsal_id",
    "selection_ref",
    "checks",
    "status",
    "synthetic_only",
    "external_messages",
    "publications",
    "rehearsed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "rehearsal_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "selection_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "synthetic_only": {
      "const": true
    },
    "external_messages": {
      "const": 0
    },
    "publications": {
      "const": 0
    },
    "rehearsed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
