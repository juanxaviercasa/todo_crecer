{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/asset-rights-review.schema.json",
  "title": "asset-rights-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "batch_ref",
    "checks",
    "status",
    "reviewer_ref",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "batch_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_ref",
          "passed"
        ],
        "properties": {
          "asset_ref": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "enum": [
        "approved_synthetic",
        "approved_real",
        "changes_requested"
      ]
    },
    "reviewer_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
