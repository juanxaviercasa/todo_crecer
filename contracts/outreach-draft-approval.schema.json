{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/outreach-draft-approval.schema.json",
  "title": "outreach-draft-approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "draft_ref",
    "draft_digest",
    "status",
    "reviewer_ref",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "draft_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "draft_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "notes": {
      "type": "string"
    },
    "reviewer_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
