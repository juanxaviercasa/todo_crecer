{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/site-regeneration-job.schema.json",
  "title": "site-regeneration-job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "room_ref",
    "truth_ref",
    "asset_batch_ref",
    "rights_review_ref",
    "design_family",
    "status",
    "synthetic",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "room_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "truth_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "asset_batch_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "rights_review_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "design_family": {
      "const": "editorial-advisor"
    },
    "status": {
      "enum": [
        "queued",
        "completed",
        "failed"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
