{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/experiment-result.schema.json","title":"ExperimentResult","type":"object","additionalProperties":false,"required":["schema_version","result_id","experiment_id","definition_digest","tenant_id","verdict","control_observation_ref","treatment_observation_ref","control_percent","treatment_percent","relative_uplift_percent","guardrail_failures","decision_note","evaluated_by","evaluated_at"],"properties":{"schema_version":{"const":"0.1.0"},"result_id":{"type":"string","pattern":"^exptr-[a-f0-9]{24}$"},"experiment_id":{"type":"string","pattern":"^expt-[a-f0-9]{24}$"},"definition_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"verdict":{"enum":["insufficient_data","equivalent","winner_control","winner_treatment","guardrail_failed"]},"control_observation_ref":{"type":"string","pattern":"^expto-[a-f0-9]{24}$"},"treatment_observation_ref":{"type":"string","pattern":"^expto-[a-f0-9]{24}$"},"control_percent":{"type":"number","minimum":0,"maximum":100},"treatment_percent":{"type":"number","minimum":0,"maximum":100},"relative_uplift_percent":{"type":["number","null"]},"guardrail_failures":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"}},"decision_note":{"type":"string","minLength":10,"maxLength":1000},"evaluated_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"evaluated_at":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"verdict":{"const":"guardrail_failed"}}},"then":{"properties":{"guardrail_failures":{"minItems":1}}}},{"if":{"properties":{"verdict":{"enum":["insufficient_data","equivalent","winner_control","winner_treatment"]}}},"then":{"properties":{"guardrail_failures":{"maxItems":0}}}}]}
