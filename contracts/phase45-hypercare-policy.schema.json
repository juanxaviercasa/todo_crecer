{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/phase45-hypercare-policy.schema.json",
  "title": "phase45-hypercare-policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_hours": {
      "type": "array",
      "prefixItems": [
        {
          "const": 0
        },
        {
          "const": 1
        },
        {
          "const": 4
        },
        {
          "const": 24
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "availability_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "latency_p95_max_ms": {
      "type": "integer",
      "minimum": 0
    },
    "error_rate_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "integrity_mismatch_max": {
      "type": "integer",
      "const": 0
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "authorization_ref",
    "checkpoint_hours",
    "availability_min",
    "latency_p95_max_ms",
    "error_rate_max",
    "integrity_mismatch_max",
    "created_at"
  ]
}
