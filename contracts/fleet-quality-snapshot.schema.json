{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/fleet-quality-snapshot.schema.json","title":"FleetQualitySnapshot","type":"object","additionalProperties":false,"required":["schema_version","snapshot_id","tenant_id","site_id","recipe_version_ref","design_version_ref","dimensions","hard_gates","overall_score","status","generated_at"],"properties":{"schema_version":{"const":"0.1.0"},"snapshot_id":{"type":"string","pattern":"^fqs-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"site_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"recipe_version_ref":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"design_version_ref":{"type":"string","pattern":"^dsv-[a-f0-9]{24}$"},"dimensions":{"type":"object","additionalProperties":false,"required":["truth","visual","accessibility","performance","conversion"],"properties":{"truth":{"type":"integer","minimum":0,"maximum":100},"visual":{"type":"integer","minimum":0,"maximum":100},"accessibility":{"type":"integer","minimum":0,"maximum":100},"performance":{"type":"integer","minimum":0,"maximum":100},"conversion":{"type":"integer","minimum":0,"maximum":100}}},"hard_gates":{"type":"object","additionalProperties":false,"required":["schema_valid","truth_verified","privacy_safe","rollback_ready"],"properties":{"schema_valid":{"type":"boolean"},"truth_verified":{"type":"boolean"},"privacy_safe":{"type":"boolean"},"rollback_ready":{"type":"boolean"}}},"overall_score":{"type":"integer","minimum":0,"maximum":100},"status":{"enum":["passing","watch","failing"]},"generated_at":{"type":"string","format":"date-time"}}}
