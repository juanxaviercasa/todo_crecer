{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/integrity-scan.schema.json","title":"IntegrityScan","type":"object","additionalProperties":false,"required":["schema_version","scan_id","database_integrity","entities_scanned","entity_digest_failures","outbox_scanned","outbox_digest_failures","status","scanned_at"],"properties":{"schema_version":{"const":"0.1.0"},"scan_id":{"type":"string","pattern":"^iscan-[a-f0-9]{24}$"},"database_integrity":{"enum":["ok","failed"]},"entities_scanned":{"type":"integer","minimum":0},"entity_digest_failures":{"type":"integer","minimum":0},"outbox_scanned":{"type":"integer","minimum":0},"outbox_digest_failures":{"type":"integer","minimum":0},"status":{"enum":["passed","failed"]},"scanned_at":{"type":"string","format":"date-time"}}}
