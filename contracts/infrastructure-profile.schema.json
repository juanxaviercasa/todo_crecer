{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hazlocrecer.com/infrastructure-profile.schema.json",
  "title": "InfrastructureProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "environment", "mode", "services", "security", "publication", "created_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "environment": {"enum": ["local", "preview", "production"]},
    "mode": {"enum": ["executable", "configuration_only"]},
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "database", "key_management", "object_storage", "queue", "malware_scan"],
      "properties": {
        "identity": {"$ref": "#/$defs/service"},
        "database": {"$ref": "#/$defs/service"},
        "key_management": {"$ref": "#/$defs/service"},
        "object_storage": {"$ref": "#/$defs/service"},
        "queue": {"$ref": "#/$defs/service"},
        "malware_scan": {"$ref": "#/$defs/service"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_isolation", "encryption_at_rest", "audit_required", "secrets_in_repository"],
      "properties": {
        "tenant_isolation": {"const": true},
        "encryption_at_rest": {"const": true},
        "audit_required": {"const": true},
        "secrets_in_repository": {"const": false}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "indexing"],
      "properties": {
        "allowed": {"type": "boolean"},
        "indexing": {"enum": ["blocked", "noindex", "index"]}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "resource", "required_configuration"],
      "properties": {
        "provider": {"enum": ["local", "cloudflare", "external"]},
        "resource": {"type": "string", "minLength": 2, "maxLength": 100},
        "required_configuration": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"const": "production"}}},
      "then": {
        "properties": {
          "mode": {"const": "configuration_only"},
          "publication": {"properties": {"allowed": {"const": false}, "indexing": {"const": "blocked"}}}
        }
      }
    }
  ]
}
