{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/vault-recovery-drill.schema.json",
  "title": "vault-recovery-drill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "drill_id",
    "vault_ref",
    "snapshot_ref",
    "lost_objects",
    "restored_objects",
    "integrity_checks",
    "status",
    "external_changes",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "drill_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "vault_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "snapshot_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "lost_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "restored_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{3,96}$"
      }
    },
    "integrity_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_ref",
          "passed"
        ],
        "properties": {
          "object_ref": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,96}$"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "external_changes": {
      "const": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
