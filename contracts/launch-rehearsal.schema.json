{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.hazlocrecer.com/launch-rehearsal.schema.json",
  "title":"LaunchRehearsal",
  "type":"object","additionalProperties":false,
  "required":["schema_version","rehearsal_id","dossier_id","dossier_hash","tenant_id","readiness_ref","environment","execution_mode","status","steps","external_changes","external_messages","publication_performed","performed_by","performed_at"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "rehearsal_id":{"type":"string","pattern":"^piloth-[a-f0-9]{24}$"},
    "dossier_id":{"type":"string","pattern":"^pilotd-[a-f0-9]{24}$"},
    "dossier_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "readiness_ref":{"type":"string","pattern":"^pilote-[a-f0-9]{24}$"},
    "environment":{"const":"local"},
    "execution_mode":{"const":"dry_run"},
    "status":{"enum":["passed","failed"]},
    "steps":{"type":"array","minItems":7,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["key","status","detail"],"properties":{"key":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,79}$"},"status":{"enum":["passed","failed"]},"detail":{"type":"string","minLength":3,"maxLength":500}}}},
    "external_changes":{"const":0},
    "external_messages":{"const":0},
    "publication_performed":{"const":false},
    "performed_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},
    "performed_at":{"type":"string","format":"date-time"}
  },
  "allOf":[{"if":{"properties":{"status":{"const":"passed"}}},"then":{"properties":{"steps":{"items":{"properties":{"status":{"const":"passed"}}}}}}}]
}
