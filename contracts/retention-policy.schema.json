{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/retention-policy.schema.json","title":"RetentionPolicy","type":"object","additionalProperties":false,"required":["schema_version","policy_id","delivered_outbox_days","transaction_days","snapshot_days","backup_days","minimum_backups","updated_by","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"policy_id":{"type":"string","pattern":"^rpolicy-[a-f0-9]{24}$"},"delivered_outbox_days":{"type":"integer","minimum":1,"maximum":3650},"transaction_days":{"type":"integer","minimum":30,"maximum":3650},"snapshot_days":{"type":"integer","minimum":1,"maximum":3650},"backup_days":{"type":"integer","minimum":1,"maximum":3650},"minimum_backups":{"type":"integer","minimum":1,"maximum":1000},"updated_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"updated_at":{"type":"string","format":"date-time"}}}
