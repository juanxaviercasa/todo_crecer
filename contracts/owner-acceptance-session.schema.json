{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-acceptance-session.schema.json",
  "title": "owner-acceptance-session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "case_ref",
    "comparison_ref",
    "token_hash",
    "acknowledgements",
    "status",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "acceptance_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "comparison_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "token_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acknowledgements": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "issued",
        "accepted",
        "changes_requested",
        "expired",
        "used"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
