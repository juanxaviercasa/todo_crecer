{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/owner-interview-form.schema.json",
  "title": "owner-interview-form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "form_id",
    "selection_ref",
    "sections",
    "required_fields",
    "synthetic_prefill",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "form_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "selection_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "questions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "required_fields": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "synthetic_prefill": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
