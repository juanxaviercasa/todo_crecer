{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/recipe-version.schema.json","title":"RecipeVersion","type":"object","additionalProperties":false,"required":["schema_version","recipe_version_id","tenant_id","recipe_id","version","archetype","status","engine_range","design_requirements","source_proposal_refs","artifact_digest","auto_publish","created_by","approved_by","created_at","updated_at"],"properties":{"schema_version":{"const":"0.1.0"},"recipe_version_id":{"type":"string","pattern":"^rv-[a-f0-9]{24}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"recipe_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-_]{1,80}$"},"version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"archetype":{"enum":["catalog","developer","advisor","projects","valuation"]},"status":{"enum":["draft","active","deprecated","retired"]},"engine_range":{"type":"object","additionalProperties":false,"required":["minimum","maximum_exclusive"],"properties":{"minimum":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"maximum_exclusive":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},"design_requirements":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["design_system_id","minimum","maximum_exclusive"],"properties":{"design_system_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-_]{1,80}$"},"minimum":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"maximum_exclusive":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}}}},"source_proposal_refs":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":160}},"artifact_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"auto_publish":{"const":false},"created_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"approved_by":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"created_at":{"t