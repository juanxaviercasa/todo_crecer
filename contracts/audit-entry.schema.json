{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/audit-entry.schema.json","title":"AuditEntry","type":"object","additionalProperties":false,
  "required":["schema_version","sequence","event_id","occurred_at","actor","action","resource","result","previous_hash","event_hash","signature"],
  "properties":{
    "schema_version":{"const":"0.1.0"},"sequence":{"type":"integer","minimum":1},"event_id":{"type":"string","pattern":"^aud-[a-f0-9]{24}$"},"occurred_at":{"type":"string","format":"date-time"},
    "actor":{"type":"object","additionalProperties":false,"required":["actor_id","role","tenant_id"],"properties":{"actor_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"role":{"enum":["owner","operator","admin","system"]},"tenant_id":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]{2,79}$"}}},
    "action":{"enum":["record.create","record.read","record.delete","asset.quarantine","asset.release","access.denied","retention.evaluate"]},"resource":{"type":"object","additionalProperties":false,"required":["record_id","tenant_id","record_type","content_hash"],"properties":{"record_id":{"type":"string"},"tenant_id":{"type":"string"},"record_type":{"type":"string"},"content_hash":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}}},"result":{"enum":["success","denied","failed"]},"previous_hash":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"event_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"signature":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
