{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.todolima.local/portability-export-manifest.schema.json",
  "title": "portability-export-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "source_adapter",
    "format",
    "object_count",
    "object_digest",
    "plaintext_exposed",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "source_adapter": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,96}$"
    },
    "format": {
      "const": "todolima-neutral-v1"
    },
    "object_count": {
      "type": "integer",
      "minimum": 1
    },
    "object_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plaintext_exposed": {
      "const": false
    },
    "status": {
      "enum": [
        "sealed",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
