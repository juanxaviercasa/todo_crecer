{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.hazlocrecer.com/retention-run.schema.json","title":"RetentionRun","type":"object","additionalProperties":false,"required":["schema_version","run_id","policy_ref","dry_run","eligible_delivered_events","deleted_delivered_events","preserved_pending_events","status","executed_by","executed_at"],"properties":{"schema_version":{"const":"0.1.0"},"run_id":{"type":"string","pattern":"^retrun-[a-f0-9]{24}$"},"policy_ref":{"type":"string","pattern":"^rpolicy-[a-f0-9]{24}$"},"dry_run":{"type":"boolean"},"eligible_delivered_events":{"type":"integer","minimum":0},"deleted_delivered_events":{"type":"integer","minimum":0},"preserved_pending_events":{"type":"integer","minimum":0},"status":{"enum":["planned","executed"]},"executed_by":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,79}$"},"executed_at":{"type":"string","format":"date-time"}}}
