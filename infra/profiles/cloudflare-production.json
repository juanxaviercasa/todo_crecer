{
  "schema_version": "0.1.0",
  "profile_id": "cloudflare-production",
  "environment": "production",
  "mode": "configuration_only",
  "services": {
    "identity": {"provider": "cloudflare", "resource": "access-jwt-plus-application-session", "required_configuration": ["CF_ACCESS_AUD", "CF_ACCESS_TEAM_DOMAIN"]},
    "database": {"provider": "cloudflare", "resource": "d1-metadata-plus-single-audit-writer", "required_configuration": ["CF_D1_DATABASE_ID"]},
    "key_management": {"provider": "cloudflare", "resource": "workers-secrets-plus-key-rotation", "required_configuration": ["VAULT_KEY", "AUDIT_KEY", "SESSION_SIGNING_KEY"]},
    "object_storage": {"provider": "cloudflare", "resource": "r2-private-assets", "required_configuration": ["CF_R2_BUCKET_NAME"]},
    "queue": {"provider": "cloudflare", "resource": "queues-background-jobs", "required_configuration": ["CF_QUEUE_NAME", "CF_DEAD_LETTER_QUEUE_NAME"]},
    "malware_scan": {"provider": "external", "resource": "scanner-webhook-adapter", "required_configuration": ["MALWARE_SCANNER_ENDPOINT", "MALWARE_SCANNER_TOKEN"]}
  },
  "security": {"tenant_isolation": true, "encryption_at_rest": true, "audit_required": true, "secrets_in_repository": false},
  "publication": {"allowed": false, "indexing": "blocked"},
  "created_at": "2026-09-30T20:00:00Z"
}
